---
import { artifacts } from "../data/artifacts";
import Icon from "./Icons.astro";
---

<section class="relative py-24 md:py-32 bg-gradient-to-b from-stone-900 via-neutral-900 to-stone-950" id="hien-vat">
  <div class="container mx-auto px-6 max-w-7xl">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="font-['Playfair_Display'] text-5xl md:text-6xl lg:text-7xl font-bold mb-6 bg-gradient-to-r from-white via-amber-200 to-amber-400 bg-clip-text text-transparent">
        Bộ sưu tập hiện vật
      </h2>
      <p class="text-xl md:text-2xl text-neutral-400 max-w-3xl mx-auto font-light mb-12">
        Những kỷ vật từ thời bao cấp
      </p>

      <!-- Controls -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-12">
        <!-- Filter Buttons -->
        <div class="flex flex-wrap justify-center gap-3">
          <button class="filter-btn active px-6 py-3 rounded-full bg-gradient-to-r from-amber-500 to-yellow-600 text-stone-950 font-semibold shadow-xl hover:shadow-amber-500/50 transition-all flex items-center gap-2" data-filter="all">
            <Icon name="collection" class="w-5 h-5" />
            Tất cả
          </button>
          <button class="filter-btn px-6 py-3 rounded-full border-2 border-amber-500/30 text-amber-300 font-semibold hover:bg-amber-500/10 hover:border-amber-500/60 transition-all flex items-center gap-2" data-filter="document">
            <Icon name="document" class="w-5 h-5" />
            Tài liệu
          </button>
          <button class="filter-btn px-6 py-3 rounded-full border-2 border-amber-500/30 text-amber-300 font-semibold hover:bg-amber-500/10 hover:border-amber-500/60 transition-all flex items-center gap-2" data-filter="photo">
            <Icon name="photo" class="w-5 h-5" />
            Ảnh
          </button>
          <button class="filter-btn px-6 py-3 rounded-full border-2 border-amber-500/30 text-amber-300 font-semibold hover:bg-amber-500/10 hover:border-amber-500/60 transition-all flex items-center gap-2" data-filter="newspaper">
            <Icon name="newspaper" class="w-5 h-5" />
            Báo
          </button>
          <button class="filter-btn px-6 py-3 rounded-full border-2 border-amber-500/30 text-amber-300 font-semibold hover:bg-amber-500/10 hover:border-amber-500/60 transition-all flex items-center gap-2" data-filter="object">
            <Icon name="cube" class="w-5 h-5" />
            Vật thể
          </button>
        </div>

        <!-- Sort Dropdown -->
        <div class="relative">
          <button
            id="sort-toggle"
            class="sort-btn px-6 py-3 rounded-full border-2 border-amber-500/30 bg-stone-900/50 backdrop-blur-sm text-amber-300 font-semibold hover:bg-amber-500/10 hover:border-amber-500/60 transition-all flex items-center gap-2 min-w-[200px] justify-between"
          >
            <div class="flex items-center gap-2">
              <Icon name="clock" class="w-5 h-5" />
              <span id="sort-label">Sắp xếp</span>
            </div>
            <svg class="w-5 h-5 transition-transform duration-300" id="sort-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div
            id="sort-dropdown"
            class="absolute top-full right-0 mt-2 w-64 bg-stone-900/95 backdrop-blur-xl border border-amber-500/30 rounded-2xl shadow-2xl overflow-hidden opacity-0 invisible transition-all duration-300 transform translate-y-2 z-50"
          >
            <button class="sort-option w-full px-4 py-3 text-left text-amber-300 hover:bg-amber-500/20 transition-colors flex items-center gap-3" data-sort="year-asc">
              <Icon name="calendar" class="w-5 h-5" />
              <span>Năm (cũ → mới)</span>
            </button>
            <button class="sort-option w-full px-4 py-3 text-left text-amber-300 hover:bg-amber-500/20 transition-colors flex items-center gap-3" data-sort="year-desc">
              <Icon name="calendar" class="w-5 h-5" />
              <span>Năm (mới → cũ)</span>
            </button>
            <button class="sort-option w-full px-4 py-3 text-left text-amber-300 hover:bg-amber-500/20 transition-colors flex items-center gap-3" data-sort="title-asc">
              <Icon name="document" class="w-5 h-5" />
              <span>Tên (A → Z)</span>
            </button>
            <button class="sort-option w-full px-4 py-3 text-left text-amber-300 hover:bg-amber-500/20 transition-colors flex items-center gap-3" data-sort="title-desc">
              <Icon name="document" class="w-5 h-5" />
              <span>Tên (Z → A)</span>
            </button>
            <button class="sort-option w-full px-4 py-3 text-left text-amber-300 hover:bg-amber-500/20 transition-colors flex items-center gap-3" data-sort="category-asc">
              <Icon name="cube" class="w-5 h-5" />
              <span>Danh mục (A → Z)</span>
            </button>
            <button class="sort-option w-full px-4 py-3 text-left text-amber-300 hover:bg-amber-500/20 transition-colors flex items-center gap-3 border-t border-amber-500/20" data-sort="default">
              <Icon name="arrow-path" class="w-5 h-5" />
              <span>Mặc định</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Gallery Grid -->
    <div id="gallery-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {artifacts.map((artifact) => (
        <a href={`/hien-vat/${artifact.id}`} class="gallery-item group block" data-category={artifact.category} data-year={artifact.year} data-title={artifact.title} data-sort-default={artifacts.indexOf(artifact)}>
          <div class="relative bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/20 rounded-2xl overflow-hidden hover:border-amber-500/50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/20 transition-all duration-500 h-full">
            <!-- Image -->
            <div class="relative aspect-square bg-gradient-to-br from-amber-900/20 to-yellow-900/10 overflow-hidden">
              {artifact.image ? (
                <img 
                  src={artifact.image} 
                  alt={artifact.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                />
              ) : (
                <div class="flex items-center justify-center h-full">
                  <span class="text-7xl opacity-40 group-hover:scale-125 transition-transform duration-500">
                    {artifact.category === 'document' ? '📄' : artifact.category === 'photo' ? '📷' : artifact.category === 'newspaper' ? '📰' : '🎯'}
                  </span>
                </div>
              )}
              <!-- Year Badge -->
              <div class="absolute top-4 right-4 px-3 py-1.5 bg-black/80 backdrop-blur-sm rounded-full text-amber-400 font-bold text-sm shadow-xl">
                {artifact.year}
              </div>
              <!-- Hover Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-6">
                <span class="px-6 py-2 bg-gradient-to-r from-amber-500 to-yellow-600 rounded-full text-stone-950 font-semibold text-sm shadow-xl">
                  Xem chi tiết
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <h3 class="text-xl font-bold mb-3 text-white group-hover:text-amber-300 transition-colors line-clamp-2">
                {artifact.title}
              </h3>
              <p class="text-neutral-400 text-sm leading-relaxed mb-4 line-clamp-3">
                {artifact.description}
              </p>
              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {artifact.tags.slice(0, 3).map(tag => (
                  <span class="px-3 py-1 bg-amber-500/15 border border-amber-500/30 rounded-full text-xs text-amber-300 font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script define:vars={{ artifacts }}>
  (function() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');
    const galleryGrid = document.getElementById('gallery-grid');
    const sortToggle = document.getElementById('sort-toggle');
    const sortDropdown = document.getElementById('sort-dropdown');
    const sortArrow = document.getElementById('sort-arrow');
    const sortLabel = document.getElementById('sort-label');
    const sortOptions = document.querySelectorAll('.sort-option');

    let currentFilter = 'all';
    let currentSort = 'default';

    // Filter functionality
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        currentFilter = filter;
        
        // Update active button
        filterBtns.forEach(b => {
          b.classList.remove('active', 'bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-stone-950', 'shadow-xl');
          b.classList.add('border-2', 'border-amber-500/30', 'text-amber-300');
        });
        btn.classList.add('active', 'bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-stone-950', 'shadow-xl');
        btn.classList.remove('border-2', 'border-amber-500/30', 'text-amber-300');

        applyFilterAndSort();
      });
    });

    // Sort functionality
    function applySort(sortType) {
      if (!galleryGrid) return;
      
      // Get all items as array
      const allItems = Array.from(galleryItems);
      
      // Sort all items based on sort type
      allItems.sort((a, b) => {
        switch(sortType) {
          case 'year-asc':
            return parseInt(a.dataset.year || '0') - parseInt(b.dataset.year || '0');
          case 'year-desc':
            return parseInt(b.dataset.year || '0') - parseInt(a.dataset.year || '0');
          case 'title-asc':
            return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'vi');
          case 'title-desc':
            return (b.dataset.title || '').localeCompare(a.dataset.title || '', 'vi');
          case 'category-asc':
            return (a.dataset.category || '').localeCompare(b.dataset.category || '', 'vi');
          case 'default':
            return parseInt(a.dataset.sortDefault || '0') - parseInt(b.dataset.sortDefault || '0');
          default:
            return 0;
        }
      });

      // Reorder all items in DOM according to sorted order
      allItems.forEach(item => {
        galleryGrid.appendChild(item);
      });

      // Update label
      const labels = {
        'year-asc': 'Năm (cũ → mới)',
        'year-desc': 'Năm (mới → cũ)',
        'title-asc': 'Tên (A → Z)',
        'title-desc': 'Tên (Z → A)',
        'category-asc': 'Danh mục',
        'default': 'Mặc định'
      };
      if (sortLabel) {
        sortLabel.textContent = labels[sortType] || 'Sắp xếp';
      }
    }

    function applyFilterAndSort() {
      // Filter
      galleryItems.forEach(item => {
        if (currentFilter === 'all' || item.dataset.category === currentFilter) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });

      // Sort
      applySort(currentSort);
    }

    // Sort dropdown toggle
    sortToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = sortDropdown?.classList.contains('opacity-100');
      
      if (isOpen) {
        sortDropdown?.classList.remove('opacity-100', 'visible', 'translate-y-0');
        sortDropdown?.classList.add('opacity-0', 'invisible', 'translate-y-2');
        sortArrow?.classList.remove('rotate-180');
      } else {
        sortDropdown?.classList.remove('opacity-0', 'invisible', 'translate-y-2');
        sortDropdown?.classList.add('opacity-100', 'visible', 'translate-y-0');
        sortArrow?.classList.add('rotate-180');
      }
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!sortToggle?.contains(e.target) && !sortDropdown?.contains(e.target)) {
        sortDropdown?.classList.remove('opacity-100', 'visible', 'translate-y-0');
        sortDropdown?.classList.add('opacity-0', 'invisible', 'translate-y-2');
        sortArrow?.classList.remove('rotate-180');
      }
    });

    // Sort option clicks
    sortOptions.forEach(option => {
      option.addEventListener('click', (e) => {
        e.stopPropagation();
        const sortType = option.getAttribute('data-sort');
        if (sortType) {
          currentSort = sortType;
          applyFilterAndSort();
          sortDropdown?.classList.remove('opacity-100', 'visible', 'translate-y-0');
          sortDropdown?.classList.add('opacity-0', 'invisible', 'translate-y-2');
          sortArrow?.classList.remove('rotate-180');
        }
      });
    });

    // Initial sort
    applyFilterAndSort();
  })();
</script>
