---
import Icon from "./Icons.astro";

const currentYear = new Date().getFullYear();
---

<footer
  class="relative py-16 bg-gradient-to-b from-stone-950 via-neutral-900 to-stone-950 border-t border-amber-500/20"
>
  <div class="container mx-auto px-6 max-w-7xl">
    <div class="grid md:grid-cols-3 gap-12 mb-12">
      <!-- About Section -->
      <div>
        <h3
          class="font-['Playfair_Display'] text-2xl font-bold mb-4 bg-gradient-to-r from-amber-300 to-yellow-400 bg-clip-text text-transparent"
        >
          Thời Bao Cấp
        </h3>
        <p class="text-neutral-400 leading-relaxed mb-4">
          Bảo tàng số về thời kỳ kinh tế bao cấp Việt Nam (1975-1986). Khám phá
          lịch sử, hiện vật và câu chuyện về giai đoạn đặc biệt này.
        </p>
        <div class="flex items-center gap-2 text-sm text-neutral-500">
          <span>1975 - 1986</span>
          <span>•</span>
          <span>Bảo Tàng Số</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-semibold text-amber-300 mb-4">Liên kết nhanh</h4>
        <ul class="space-y-2">
          <li>
            <a
              href="/#dong-thoi-gian"
              class="text-neutral-400 hover:text-amber-300 transition-colors flex items-center gap-2"
            >
              <Icon name="clock" class="w-4 h-4" />
              Dòng thời gian
            </a>
          </li>
          <li>
            <a
              href="/#ly-do"
              class="text-neutral-400 hover:text-amber-300 transition-colors flex items-center gap-2"
            >
              <Icon name="book" class="w-4 h-4" />
              Lý do
            </a>
          </li>
          <li>
            <a
              href="/#hien-vat"
              class="text-neutral-400 hover:text-amber-300 transition-colors flex items-center gap-2"
            >
              <Icon name="cube" class="w-4 h-4" />
              Hiện vật
            </a>
          </li>
          <li>
            <a
              href="/#trai-nghiem"
              class="text-neutral-400 hover:text-amber-300 transition-colors flex items-center gap-2"
            >
              <Icon name="sparkles" class="w-4 h-4" />
              Trải nghiệm
            </a>
          </li>
        </ul>
      </div>

      <!-- Games & Experience -->
      <div>
        <h4 class="font-semibold text-amber-300 mb-4">
          Trò chơi & Trải nghiệm
        </h4>
        <ul class="space-y-2">
          <li>
            <a
              href="/tro-choi/doi-tem-phieu"
              class="text-neutral-400 hover:text-amber-300 transition-colors flex items-center gap-2"
            >
              <Icon name="puzzle" class="w-4 h-4" />
              Đổi tem phiếu
            </a>
          </li>
          <li>
            <a
              href="/trai-nghiem/cau-chuyen"
              class="text-neutral-400 hover:text-amber-300 transition-colors flex items-center gap-2"
            >
              <Icon name="book" class="w-4 h-4" />
              Kể chuyện lịch sử
            </a>
          </li>
          <li>
            <a
              href="/trai-nghiem/kien-thuc"
              class="text-neutral-400 hover:text-amber-300 transition-colors flex items-center gap-2"
            >
              <Icon name="academic-cap" class="w-4 h-4" />
              Kiến thức & Câu đố
            </a>
          </li>
          <li>
            <a
              href="/trai-nghiem/cua-hang"
              class="text-neutral-400 hover:text-amber-300 transition-colors flex items-center gap-2"
            >
              <Icon name="shopping-cart" class="w-4 h-4" />
              Cửa hàng mậu dịch
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div
      class="h-px bg-gradient-to-r from-transparent via-amber-500/30 to-transparent mb-8"
    >
    </div>

    <div class="text-center">
      <p class="text-neutral-500 text-sm">
        © {currentYear} - Bảo Tàng Thời Bao Cấp. Tất cả quyền được bảo lưu.
      </p>
      <p class="text-neutral-600 text-xs mt-2">
        Dự án giáo dục về lịch sử Việt Nam
      </p>
      <p class="text-neutral-600 text-xs mt-2">
        Người thực hiện: <a
          href="mailto:huyit2003@gmail.com"
          class="underline hover:text-amber-300">huyit2003@gmail.com</a
        >
      </p>
    </div>
  </div>
</footer>
