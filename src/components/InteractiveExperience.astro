---

---

<section
  class="relative py-24 md:py-32 bg-gradient-to-b from-stone-950 via-neutral-900 to-stone-900"
  id="trai-nghiem"
>
  <div class="container mx-auto px-6 max-w-7xl">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <h2
        class="font-['Playfair_Display'] text-5xl md:text-6xl lg:text-7xl font-bold mb-6 bg-gradient-to-r from-white via-amber-200 to-amber-400 bg-clip-text text-transparent"
      >
        Trải nghiệm tương tác
      </h2>
      <p
        class="text-xl md:text-2xl text-neutral-400 max-w-3xl mx-auto font-light"
      >
        Tham gia và khám phá thời bao cấp
      </p>
    </div>

    <!-- Experience Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-20">
      <div
        class="group bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/20 rounded-3xl p-8 text-center hover:border-amber-500/50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/20 transition-all duration-500"
      >
        <div
          class="text-7xl mb-6 group-hover:scale-110 group-hover:rotate-6 transition-transform duration-500"
        >
          📖
        </div>
        <h3
          class="text-2xl font-bold mb-4 text-white group-hover:text-amber-300 transition-colors"
        >
          Kể chuyện lịch sử
        </h3>
        <p class="text-neutral-300 leading-relaxed mb-6">
          Lắng nghe những câu chuyện từ người dân thời bao cấp
        </p>
        <a
          href="/trai-nghiem/cau-chuyen"
          class="inline-block px-6 py-3 bg-gradient-to-r from-amber-500/20 to-yellow-500/20 border border-amber-500/40 rounded-full text-amber-300 font-semibold hover:from-amber-500 hover:to-yellow-600 hover:text-stone-950 transition-all duration-300"
        >
          Khám phá
        </a>
      </div>

      <div
        class="group bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/20 rounded-3xl p-8 text-center hover:border-amber-500/50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/20 transition-all duration-500"
      >
        <div
          class="text-7xl mb-6 group-hover:scale-110 group-hover:rotate-6 transition-transform duration-500"
        >
          ⚖️
        </div>
        <h3
          class="text-2xl font-bold mb-4 text-white group-hover:text-amber-300 transition-colors"
        >
          So sánh đổi thay
        </h3>
        <p class="text-neutral-300 leading-relaxed mb-6">
          Xem sự khác biệt giữa thời bao cấp và hiện tại
        </p>
        <a
          href="/trai-nghiem/so-sanh"
          class="inline-block px-6 py-3 bg-gradient-to-r from-amber-500/20 to-yellow-500/20 border border-amber-500/40 rounded-full text-amber-300 font-semibold hover:from-amber-500 hover:to-yellow-600 hover:text-stone-950 transition-all duration-300"
        >
          So sánh
        </a>
      </div>

      <div
        class="group bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/20 rounded-3xl p-8 text-center hover:border-amber-500/50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/20 transition-all duration-500"
      >
        <div
          class="text-7xl mb-6 group-hover:scale-110 group-hover:rotate-6 transition-transform duration-500"
        >
          🏪
        </div>
        <h3
          class="text-2xl font-bold mb-4 text-white group-hover:text-amber-300 transition-colors"
        >
          Cửa hàng ảo
        </h3>
        <p class="text-neutral-300 leading-relaxed mb-6">
          Tham quan cửa hàng mậu dịch thời bao cấp
        </p>
        <a
          href="/trai-nghiem/cua-hang"
          class="inline-block px-6 py-3 bg-gradient-to-r from-amber-500/20 to-yellow-500/20 border border-amber-500/40 rounded-full text-amber-300 font-semibold hover:from-amber-500 hover:to-yellow-600 hover:text-stone-950 transition-all duration-300"
        >
          Tham quan
        </a>
      </div>

      <div
        class="group bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/20 rounded-3xl p-8 text-center hover:border-amber-500/50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/20 transition-all duration-500"
      >
        <div
          class="text-7xl mb-6 group-hover:scale-110 group-hover:rotate-6 transition-transform duration-500"
        >
          🎯
        </div>
        <h3
          class="text-2xl font-bold mb-4 text-white group-hover:text-amber-300 transition-colors"
        >
          Kiến thức & Câu đố
        </h3>
        <p class="text-neutral-300 leading-relaxed mb-6">
          Thử sức với các câu hỏi về thời kỳ này
        </p>
        <a
          href="/trai-nghiem/kien-thuc"
          class="inline-block px-6 py-3 bg-gradient-to-r from-amber-500/20 to-yellow-500/20 border border-amber-500/40 rounded-full text-amber-300 font-semibold hover:from-amber-500 hover:to-yellow-600 hover:text-stone-950 transition-all duration-300"
        >
          Bắt đầu
        </a>
      </div>
    </div>
  </div>
</section>
