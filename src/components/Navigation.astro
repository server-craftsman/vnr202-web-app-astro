---
import Icon from "./Icons.astro";
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-stone-950/80 backdrop-blur-xl border-b border-amber-500/20 shadow-2xl"
>
  <div
    class="container mx-auto px-6 py-2 relative flex items-center min-h-[5rem]"
  >
    <!-- Logo group -->
    <a href="/" class="flex items-center gap-4 group relative z-10 select-none">
      <!-- <div class="absolute left-0 top-1/2 -translate-y-1/2 w-14 h-14 z-0">
        <div
          class="absolute inset-0 bg-gradient-to-br from-amber-500 to-yellow-600 rounded-2xl blur-md opacity-50 group-hover:opacity-75 transition-opacity duration-300"
        >
        </div>
        <div
          class="relative w-14 h-14 bg-gradient-to-br from-amber-500 via-yellow-500 to-amber-600 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-2xl shadow-amber-500/30 border-2 border-amber-400/50"
        >
          <Icon name="home" class="w-7 h-7 text-stone-950" />
          <div
            class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/20 to-transparent rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>
        </div>
      </div> -->
      <!-- Text -->
      <div class="flex flex-col ml-16 md:ml-20">
        <div
          class="font-['Playfair_Display'] font-bold text-xl md:text-2xl bg-gradient-to-r from-amber-200 via-amber-300 to-yellow-400 bg-clip-text text-transparent group-hover:from-amber-300 group-hover:via-yellow-400 group-hover:to-amber-500 transition-all duration-300 leading-tight"
        >
          Thời Bao Cấp
        </div>
        <div class="flex items-center gap-2 text-xs md:text-sm mt-1">
          <span
            class="text-neutral-500 group-hover:text-neutral-400 transition-colors"
            >1975 - 1986</span
          >
          <div class="w-1 h-1 bg-amber-500 rounded-full"></div>
          <span
            class="text-amber-600 group-hover:text-amber-500 font-semibold transition-colors"
            >Bảo Tàng Số</span
          >
        </div>
      </div>
      <!-- Hover accent line -->
      <div
        class="absolute -bottom-1 left-0 w-28 h-0.5 bg-gradient-to-r from-transparent via-amber-500 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
        style="z-index: 1"
      >
      </div>
    </a>

    <!-- Desktop Menu -->
    <div class="hidden md:flex items-center gap-1 ml-auto">
      <a
        href="/#dong-thoi-gian"
        class="flex items-center gap-2 px-3 py-2 text-neutral-300 hover:text-amber-400 font-medium transition-colors rounded-lg group"
      >
        <Icon
          name="clock"
          class="w-4 h-4 group-hover:scale-110 transition-transform"
        />
        <span class="hidden lg:inline">Dòng thời gian</span>
      </a>
      <a
        href="/#ly-do"
        class="flex items-center gap-2 px-3 py-2 text-neutral-300 hover:text-amber-400 font-medium transition-colors rounded-lg group"
      >
        <Icon
          name="book"
          class="w-4 h-4 group-hover:scale-110 transition-transform"
        />
        <span class="hidden lg:inline">Lý do</span>
      </a>
      <a
        href="/#hien-vat"
        class="flex items-center gap-2 px-3 py-2 text-neutral-300 hover:text-amber-400 font-medium transition-colors rounded-lg group"
      >
        <Icon
          name="cube"
          class="w-4 h-4 group-hover:scale-110 transition-transform"
        />
        <span class="hidden lg:inline">Hiện vật</span>
      </a>
      <a
        href="/#trai-nghiem"
        class="flex items-center gap-2 px-3 py-2 text-neutral-300 hover:text-amber-400 font-medium transition-colors rounded-lg group"
      >
        <Icon
          name="sparkles"
          class="w-4 h-4 group-hover:scale-110 transition-transform"
        />
        <span class="hidden lg:inline">Trải nghiệm</span>
      </a>
      <a
        href="/tro-choi/doi-tem-phieu"
        class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-amber-500/20 to-yellow-500/20 border border-amber-500/40 rounded-full text-amber-300 font-semibold hover:from-amber-500 hover:to-yellow-600 hover:text-stone-950 transition-all ml-2 shadow"
      >
        <Icon name="puzzle" class="w-4 h-4" />
        <span class="hidden sm:inline">Mini-game</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      class="ml-auto md:hidden text-amber-300 p-2 hover:bg-amber-500/10 rounded-lg transition-colors"
      id="mobile-menu-btn"
      aria-label="Toggle menu"
    >
      <svg
        class="w-7 h-7"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile Menu -->
<div
  class="hidden md:hidden animate-fade-in-down mt-1 pb-4 space-y-1 border-t border-amber-500/20 pt-3 bg-stone-950/95 backdrop-blur shadow-lg rounded-b-2xl mx-3 mb-2"
  id="mobile-menu"
>
  <a
    href="/#dong-thoi-gian"
    class="flex items-center gap-3 text-neutral-300 hover:text-amber-400 hover:bg-amber-500/10 font-medium transition-colors py-3 px-4 rounded-lg"
  >
    <Icon name="clock" class="w-5 h-5" />
    Dòng thời gian
  </a>
  <a
    href="/#ly-do"
    class="flex items-center gap-3 text-neutral-300 hover:text-amber-400 hover:bg-amber-500/10 font-medium transition-colors py-3 px-4 rounded-lg"
  >
    <Icon name="book" class="w-5 h-5" />
    Lý do
  </a>
  <a
    href="/#hien-vat"
    class="flex items-center gap-3 text-neutral-300 hover:text-amber-400 hover:bg-amber-500/10 font-medium transition-colors py-3 px-4 rounded-lg"
  >
    <Icon name="cube" class="w-5 h-5" />
    Hiện vật
  </a>
  <a
    href="/#trai-nghiem"
    class="flex items-center gap-3 text-neutral-300 hover:text-amber-400 hover:bg-amber-500/10 font-medium transition-colors py-3 px-4 rounded-lg"
  >
    <Icon name="sparkles" class="w-5 h-5" />
    Trải nghiệm
  </a>
  <a
    href="/tro-choi/doi-tem-phieu"
    class="flex items-center gap-3 text-amber-300 bg-amber-500/10 hover:bg-amber-500/20 font-semibold py-3 px-4 rounded-lg"
  >
    <Icon name="puzzle" class="w-5 h-5" />
    Mini-game
  </a>
</div>

<!-- Spacer -->
<div class="h-16 md:h-20"></div>

<style>
  @keyframes fade-in-down {
    from {
      opacity: 0;
      transform: translateY(-16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .animate-fade-in-down {
    animation: fade-in-down 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  mobileMenuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
    if (mobileMenu && !mobileMenu.classList.contains("hidden")) {
      mobileMenu.style.animation =
        "fade-in-down 0.2s cubic-bezier(0.4,0,0.2,1)";
    }
  });

  // Optionally: close the menu if clicking outside (mobile)
  document.addEventListener("click", function (event) {
    const target = event.target as Node;
    if (
      mobileMenu &&
      mobileMenuBtn &&
      !mobileMenu.classList.contains("hidden") &&
      !mobileMenu.contains(target) &&
      !mobileMenuBtn.contains(target)
    ) {
      mobileMenu.classList.add("hidden");
    }
  });
</script>
