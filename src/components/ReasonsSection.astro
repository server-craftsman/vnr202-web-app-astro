---
import { baoCapReasons } from "../data/reasons";
import Icon from "./Icons.astro";
---

<section
  class="relative py-24 md:py-32 bg-gradient-to-b from-stone-950 via-neutral-900 to-stone-900"
  id="ly-do"
>
  <div class="container mx-auto px-6 max-w-7xl">
    <div class="text-center mb-20 animate-fade-in">
      <h2
        class="font-['Playfair_Display'] text-5xl md:text-6xl lg:text-7xl font-bold mb-6 bg-gradient-to-r from-white via-amber-200 to-amber-400 bg-clip-text text-transparent"
      >
        Tại sao áp dụng kinh tế bao cấp?
      </h2>
      <p
        class="text-xl md:text-2xl text-neutral-400 max-w-3xl mx-auto font-light"
      >
        Những lý do dẫn đến quyết định lịch sử
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {
        baoCapReasons
          .sort((a, b) => a.priority - b.priority)
          .map((reason) => (
            <div class="group reason-card bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/20 rounded-3xl p-8 hover:border-amber-500/50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/20 transition-all duration-500">
              <div class="text-7xl mb-6 group-hover:scale-110 group-hover:rotate-6 transition-transform duration-500">
                {reason.icon}
              </div>

              <a href={`/ly-do/${reason.id}`} class="block">
                <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-amber-300 transition-colors">
                  {reason.title}
                </h3>
              </a>

              <p class="text-neutral-300 leading-relaxed mb-6">
                {reason.description}
              </p>

              <button
                class="toggle-btn w-full flex items-center justify-end gap-3 px-4 py-3 text-amber-400 hover:text-amber-300 font-semibold text-sm transition-all duration-300 rounded-xl cursor-pointer hover:bg-transparent focus:bg-transparent active:bg-transparent"
                data-reason-id={reason.id}
                style="background: inherit;"
              >
                <span class="flex items-center gap-2">
                  <Icon name="information" class="w-4 h-4" />
                  <span>Xem chi tiết</span>
                </span>
                <svg
                  class="w-5 h-5 transition-transform duration-300 transform"
                  data-arrow-icon
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>

              <div
                class="reason-details mt-0 overflow-hidden transition-all duration-500 ease-in-out"
                data-details-container
                style="max-height: 0; opacity: 0;"
              >
                <div class="pt-6 border-t border-amber-500/20 mt-6">
                  <div class="flex items-center gap-2 mb-4">
                    <Icon name="sparkles" class="w-5 h-5 text-amber-400" />
                    <h4 class="text-amber-300 font-semibold text-sm uppercase tracking-wider">
                      Nội dung
                    </h4>
                  </div>
                  <ul class="space-y-3">
                    {reason.details.map((detail, idx) => (
                      <li
                        class="flex items-start gap-3 text-neutral-200 text-sm leading-relaxed pl-2"
                        style={`animation-delay: ${idx * 50}ms;`}
                      >
                        <span class="text-amber-400 mt-1.5 flex-shrink-0">
                          <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                          >
                            <path
                              fill-rule="evenodd"
                              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                              clip-rule="evenodd"
                            />
                          </svg>
                        </span>
                        <span class="flex-1">{detail}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
      }
    </div>

    <!-- Context Box -->
    <div class="max-w-5xl mx-auto">
      <div
        class="relative bg-gradient-to-br from-amber-900/20 to-yellow-900/10 backdrop-blur-xl border-2 border-amber-500/30 rounded-3xl p-10 md:p-16 text-center shadow-2xl"
      >
        <h3
          class="font-['Playfair_Display'] text-3xl md:text-4xl font-bold mb-6 text-amber-300"
        >
          Bối cảnh lịch sử
        </h3>
        <p class="text-lg md:text-xl text-neutral-200 leading-relaxed">
          Sau chiến thắng 1975, Việt Nam đứng trước thách thức lớn về việc xây
          dựng đất nước thống nhất. Trong bối cảnh đó, việc áp dụng mô hình kinh
          tế kế hoạch hóa tập trung được xem là phù hợp với điều kiện và hoàn
          cảnh lúc bấy giờ. Tuy nhiên, sau 11 năm thực hiện, những hạn chế của
          mô hình này đã trở nên rõ ràng, dẫn đến quyết định <span
            class="text-amber-300 font-semibold">Đổi Mới năm 1986</span
          >.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const reasonCards = document.querySelectorAll(".reason-card");
    let hoverTimeout: NodeJS.Timeout | null = null;
    let leaveTimeout: NodeJS.Timeout | null = null;

    function openDropdown(card: Element) {
      const detailsContainer = card.querySelector(
        "[data-details-container]"
      ) as HTMLElement | null;
      const arrowIcon = card.querySelector(
        "[data-arrow-icon]"
      ) as HTMLElement | null;
      const button = card.querySelector(".toggle-btn");

      if (!detailsContainer || !button) return;

      const content = detailsContainer.querySelector("div");

      if (!content) return;

      const isExpanded =
        detailsContainer.style.maxHeight &&
        detailsContainer.style.maxHeight !== "0px";

      if (isExpanded) return;

      const contentHeight = content.scrollHeight;

      document
        .querySelectorAll("[data-details-container]")
        .forEach((container) => {
          if (container !== detailsContainer) {
            (container as HTMLElement).style.maxHeight = "0px";
            (container as HTMLElement).style.opacity = "0";
            (container as HTMLElement).style.marginTop = "0px";
          }
        });

      document.querySelectorAll("[data-arrow-icon]").forEach((icon) => {
        if (icon !== arrowIcon) {
          icon.classList.remove("rotate-180");
        }
      });

      document.querySelectorAll(".toggle-btn").forEach((btn) => {
        if (btn !== button) {
          btn.classList.remove("bg-amber-500/20");
        }
      });

      detailsContainer.style.maxHeight = `${contentHeight + 24}px`;
      detailsContainer.style.opacity = "1";
      detailsContainer.style.marginTop = "6px";
      if (arrowIcon) arrowIcon.classList.add("rotate-180");
      button.classList.add("bg-amber-500/20");
    }

    function closeDropdown(card: Element) {
      const detailsContainer = card.querySelector(
        "[data-details-container]"
      ) as HTMLElement | null;
      const arrowIcon = card.querySelector(
        "[data-arrow-icon]"
      ) as HTMLElement | null;
      const button = card.querySelector(".toggle-btn") as HTMLElement | null;

      if (!detailsContainer) return;

      const isExpanded =
        detailsContainer.style.maxHeight &&
        detailsContainer.style.maxHeight !== "0px";

      if (!isExpanded) return;

      detailsContainer.style.maxHeight = "0px";
      detailsContainer.style.opacity = "0";
      detailsContainer.style.marginTop = "0px";
      if (arrowIcon) arrowIcon.classList.remove("rotate-180");
      if (button) button.classList.remove("bg-amber-500/20");
    }

    reasonCards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        if (leaveTimeout) {
          clearTimeout(leaveTimeout);
          leaveTimeout = null;
        }

        hoverTimeout = setTimeout(() => {
          openDropdown(card);
        }, 200);
      });

      card.addEventListener("mouseleave", () => {
        if (hoverTimeout) {
          clearTimeout(hoverTimeout);
          hoverTimeout = null;
        }

        leaveTimeout = setTimeout(() => {
          closeDropdown(card);
        }, 300);
      });
    });

    function handleResize() {
      document
        .querySelectorAll("[data-details-container]")
        .forEach((container) => {
          if (
            (container as HTMLElement).style.maxHeight &&
            (container as HTMLElement).style.maxHeight !== "0px"
          ) {
            const content = container.querySelector("div");
            if (content) {
              const contentHeight = content.scrollHeight;
              (container as HTMLElement).style.maxHeight =
                `${contentHeight + 24}px`;
            }
          }
        });
    }

    window.addEventListener("resize", handleResize);
  })();
</script>
