---
import type { BaoCapReason } from '../data/reasons';
import { baoCapReasons } from '../data/reasons';
---

<section class="reasons-section" id="reasons">
	<div class="container">
		<div class="section-header">
			<h2 class="section-title">Tại sao áp dụng kinh tế bao cấp?</h2>
			<p class="section-subtitle">Những lý do dẫn đến quyết định lịch sử</p>
		</div>

		<div class="reasons-grid">
			{baoCapReasons
				.sort((a, b) => a.priority - b.priority)
				.map((reason, index) => (
					<div class="reason-card" data-priority={reason.priority}>
						<div class="card-icon">{reason.icon}</div>
						<h3 class="card-title">{reason.title}</h3>
						<p class="card-description">{reason.description}</p>
						<button class="card-toggle" data-id={reason.id}>
							<span>Xem chi tiết</span>
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
							</svg>
						</button>
						<div class="card-details" data-details-id={reason.id}>
							<ul>
								{reason.details.map(detail => (
									<li>{detail}</li>
								))}
							</ul>
						</div>
					</div>
				))}
		</div>

		<div class="reasons-intro">
			<div class="intro-content">
				<h3>Bối cảnh lịch sử</h3>
				<p>
					Sau chiến thắng 1975, Việt Nam đứng trước thách thức lớn về việc xây dựng 
					đất nước thống nhất. Trong bối cảnh đó, việc áp dụng mô hình kinh tế kế hoạch 
					hóa tập trung được xem là phù hợp với điều kiện và hoàn cảnh lúc bấy giờ. 
					Tuy nhiên, sau 11 năm thực hiện, những hạn chế của mô hình này đã trở nên rõ ràng, 
					dẫn đến quyết định Đổi Mới năm 1986.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.reasons-section {
		position: relative;
		padding: 8rem 2rem;
		background: linear-gradient(180deg, #2d2d2d 0%, #1a1a1a 100%);
		min-height: 100vh;
	}

	.container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.section-header {
		text-align: center;
		margin-bottom: 6rem;
		animation: fadeInUp 0.8s ease-out;
	}

	.section-title {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 700;
		margin-bottom: 1rem;
		background: linear-gradient(135deg, #ffffff 0%, #d4af37 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.section-subtitle {
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.7);
		max-width: 600px;
		margin: 0 auto;
	}

	.reasons-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
		margin-bottom: 6rem;
	}

	.reason-card {
		background: rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 24px;
		padding: 2.5rem;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
		position: relative;
		overflow: hidden;
		opacity: 0;
		animation: fadeInUp 0.6s ease-out forwards;
	}

	.reason-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
		transition: left 0.6s ease;
	}

	.reason-card:hover::before {
		left: 100%;
	}

	.reason-card:hover {
		transform: translateY(-10px);
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(212, 175, 55, 0.5);
		box-shadow: 0 25px 50px rgba(212, 175, 55, 0.15);
	}

	.reason-card.active {
		border-color: rgba(212, 175, 55, 0.8);
		box-shadow: 0 0 40px rgba(212, 175, 55, 0.3);
	}

	.card-icon {
		font-size: 4rem;
		margin-bottom: 1.5rem;
		transition: transform 0.3s ease;
	}

	.reason-card:hover .card-icon {
		transform: scale(1.1) rotate(5deg);
	}

	.card-title {
		font-size: 1.5rem;
		font-weight: 600;
		margin-bottom: 1rem;
		color: #fff;
		line-height: 1.3;
	}

	.card-description {
		color: rgba(255, 255, 255, 0.7);
		line-height: 1.8;
		margin-bottom: 1.5rem;
	}

	.card-toggle {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0;
		background: none;
		border: none;
		color: #d4af37;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.3s ease;
		font-size: 0.875rem;
	}

	.card-toggle:hover {
		color: #f4bf37;
		gap: 0.75rem;
	}

	.card-toggle svg {
		transition: transform 0.3s ease;
	}

	.reason-card.active .card-toggle svg {
		transform: rotate(180deg);
	}

	.card-details {
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.4s ease, padding 0.4s ease;
		padding-top: 0;
	}

	.reason-card.active .card-details {
		max-height: 500px;
		padding-top: 1.5rem;
	}

	.card-details ul {
		list-style: none;
		padding: 0;
	}

	.card-details li {
		padding: 0.75rem 0;
		padding-left: 1.5rem;
		position: relative;
		color: rgba(255, 255, 255, 0.8);
		line-height: 1.6;
	}

	.card-details li::before {
		content: '▶';
		position: absolute;
		left: 0;
		color: #d4af37;
		font-size: 0.875rem;
	}

	.reasons-intro {
		margin-top: 6rem;
		animation: fadeInUp 1s ease-out;
	}

	.intro-content {
		background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(244, 191, 55, 0.05));
		border: 2px solid rgba(212, 175, 55, 0.3);
		border-radius: 30px;
		padding: 3rem;
		max-width: 900px;
		margin: 0 auto;
		text-align: center;
	}

	.intro-content h3 {
		font-family: 'Playfair Display', serif;
		font-size: 2rem;
		margin-bottom: 1.5rem;
		color: #d4af37;
	}

	.intro-content p {
		font-size: 1.125rem;
		line-height: 1.9;
		color: rgba(255, 255, 255, 0.9);
	}

	@media (max-width: 768px) {
		.reasons-section {
			padding: 4rem 1rem;
		}

		.reasons-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.reason-card {
			padding: 2rem;
		}

		.card-icon {
			font-size: 3rem;
		}

		.intro-content {
			padding: 2rem 1.5rem;
		}
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<script>
	document.querySelectorAll('.card-toggle').forEach((button) => {
		button.addEventListener('click', (e) => {
			const card = button.closest('.reason-card');
			const isActive = card.classList.contains('active');
			
			// Close all other cards
			document.querySelectorAll('.reason-card').forEach((otherCard) => {
				if (otherCard !== card) {
					otherCard.classList.remove('active');
				}
			});
			
			// Toggle current card
			card.classList.toggle('active', !isActive);
		});
	});
</script>
