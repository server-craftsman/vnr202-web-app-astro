---
import { baoCapReasons } from "../data/reasons";
---

<section class="relative py-24 md:py-32 bg-gradient-to-b from-stone-950 via-neutral-900 to-stone-900" id="reasons">
  <div class="container mx-auto px-6 max-w-7xl">
    <!-- Section Header -->
    <div class="text-center mb-20 animate-fade-in">
      <h2 class="font-['Playfair_Display'] text-5xl md:text-6xl lg:text-7xl font-bold mb-6 bg-gradient-to-r from-white via-amber-200 to-amber-400 bg-clip-text text-transparent">
        Tại sao áp dụng kinh tế bao cấp?
      </h2>
      <p class="text-xl md:text-2xl text-neutral-400 max-w-3xl mx-auto font-light">
        Những lý do dẫn đến quyết định lịch sử
      </p>
    </div>

    <!-- Reasons Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {baoCapReasons.sort((a, b) => a.priority - b.priority).map((reason) => (
        <div class="group reason-card bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/20 rounded-3xl p-8 hover:border-amber-500/50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/20 transition-all duration-500 cursor-pointer">
          <!-- Icon -->
          <div class="text-7xl mb-6 group-hover:scale-110 group-hover:rotate-6 transition-transform duration-500">
            {reason.icon}
          </div>

          <!-- Title -->
          <a href={`/reasons/${reason.id}`} class="block">
            <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-amber-300 transition-colors">
              {reason.title}
            </h3>
          </a>

          <!-- Description -->
          <p class="text-neutral-300 leading-relaxed mb-6">
            {reason.description}
          </p>

          <!-- Toggle Details Button -->
          <button 
            class="toggle-btn flex items-center gap-2 text-amber-400 hover:text-amber-300 font-semibold text-sm transition-colors group/btn"
            data-reason-id={reason.id}
          >
            <span>Xem chi tiết</span>
            <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <!-- Details (Hidden by default) -->
          <div class="reason-details hidden mt-6 pt-6 border-t border-amber-500/20">
            <ul class="space-y-3">
              {reason.details.map(detail => (
                <li class="flex items-start gap-3 text-neutral-200 text-sm leading-relaxed">
                  <span class="text-amber-400 mt-1">▸</span>
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Context Box -->
    <div class="max-w-5xl mx-auto">
      <div class="relative bg-gradient-to-br from-amber-900/20 to-yellow-900/10 backdrop-blur-xl border-2 border-amber-500/30 rounded-3xl p-10 md:p-16 text-center shadow-2xl">
        <h3 class="font-['Playfair_Display'] text-3xl md:text-4xl font-bold mb-6 text-amber-300">
          Bối cảnh lịch sử
        </h3>
        <p class="text-lg md:text-xl text-neutral-200 leading-relaxed">
          Sau chiến thắng 1975, Việt Nam đứng trước thách thức lớn về việc xây dựng đất nước thống nhất. Trong bối cảnh đó, việc áp dụng mô hình kinh tế kế hoạch hóa tập trung được xem là phù hợp với điều kiện và hoàn cảnh lúc bấy giờ. Tuy nhiên, sau 11 năm thực hiện, những hạn chế của mô hình này đã trở nên rõ ràng, dẫn đến quyết định <span class="text-amber-300 font-semibold">Đổi Mới năm 1986</span>.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.reason-card');
      const details = card?.querySelector('.reason-details');
      const svg = btn.querySelector('svg');
      
      if (details) {
        const isHidden = details.classList.contains('hidden');
        
        // Close all other details
        document.querySelectorAll('.reason-details').forEach(d => d.classList.add('hidden'));
        document.querySelectorAll('.toggle-btn svg').forEach(s => s.classList.remove('rotate-180'));
        
        if (isHidden) {
          details.classList.remove('hidden');
          svg?.classList.add('rotate-180');
        }
      }
    });
  });
</script>
