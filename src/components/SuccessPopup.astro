---
---

<!-- Success Popup Container -->
<div id="success-popup" class="fixed inset-0 z-[9999] hidden items-center justify-center p-6 bg-black/80 backdrop-blur-md">
  <div class="relative max-w-md w-full">
    <!-- Confetti Animation Background -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="confetti"></div>
      <div class="confetti"></div>
      <div class="confetti"></div>
      <div class="confetti"></div>
      <div class="confetti"></div>
    </div>

    <!-- Popup Card -->
    <div class="relative bg-gradient-to-br from-green-900/90 to-emerald-900/90 backdrop-blur-xl border-2 border-green-400/50 rounded-3xl p-10 shadow-2xl shadow-green-500/50 animate-popup">
      <!-- Success Icon -->
      <div class="flex items-center justify-center mb-6">
        <div class="relative">
          <div class="absolute inset-0 bg-green-400 rounded-full animate-ping opacity-40"></div>
          <div class="relative w-24 h-24 bg-gradient-to-br from-green-400 to-emerald-500 rounded-full flex items-center justify-center shadow-2xl">
            <svg class="w-12 h-12 text-white animate-check" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Title -->
      <h2 class="font-['Playfair_Display'] text-3xl font-bold text-center text-white mb-4">
        Mua hàng thành công!
      </h2>

      <!-- Message -->
      <div id="popup-message" class="text-center text-green-100 leading-relaxed mb-6">
        <!-- Will be filled by JavaScript -->
      </div>

      <!-- Details -->
      <div id="popup-details" class="bg-green-950/50 border border-green-500/30 rounded-2xl p-6 mb-6">
        <!-- Will be filled by JavaScript -->
      </div>

      <!-- Close Button -->
      <button 
        id="close-popup" 
        class="w-full px-8 py-4 bg-gradient-to-r from-green-500 to-emerald-600 rounded-full text-white font-bold text-lg shadow-xl hover:scale-105 transition-all duration-300 flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        Hoàn tất
      </button>
    </div>
  </div>
</div>

<style>
  @keyframes popup {
    0% {
      opacity: 0;
      transform: scale(0.8) translateY(20px);
    }
    60% {
      transform: scale(1.05);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes check {
    0% {
      stroke-dasharray: 0, 100;
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dasharray: 100, 100;
      stroke-dashoffset: 0;
    }
  }

  @keyframes confetti-fall {
    0% {
      transform: translateY(-100vh) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translateY(100vh) rotate(720deg);
      opacity: 0;
    }
  }

  .animate-popup {
    animation: popup 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  .animate-check {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: check 0.6s ease-in-out 0.3s forwards;
  }

  .confetti {
    position: absolute;
    width: 10px;
    height: 10px;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    animation: confetti-fall 3s ease-in-out infinite;
  }

  .confetti:nth-child(1) {
    left: 10%;
    animation-delay: 0s;
    background: linear-gradient(135deg, #10b981, #059669);
  }

  .confetti:nth-child(2) {
    left: 30%;
    animation-delay: 0.2s;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
  }

  .confetti:nth-child(3) {
    left: 50%;
    animation-delay: 0.4s;
    background: linear-gradient(135deg, #10b981, #059669);
  }

  .confetti:nth-child(4) {
    left: 70%;
    animation-delay: 0.6s;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
  }

  .confetti:nth-child(5) {
    left: 90%;
    animation-delay: 0.8s;
    background: linear-gradient(135deg, #10b981, #059669);
  }
</style>

