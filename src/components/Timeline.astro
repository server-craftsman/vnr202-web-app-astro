---
import { timelineData } from "../data/timeline";
import { slugify } from "../utils/slugify";
import Icon from "./Icons.astro";
import ImageZoom from "./ImageZoom.astro";
---

<section class="relative py-24 md:py-32 bg-gradient-to-b from-stone-900 via-neutral-900 to-stone-950" id="timeline">
  <div class="container mx-auto px-6 max-w-7xl">
    <!-- Section Header -->
    <div class="text-center mb-20 animate-fade-in">
      <h2 class="font-['Playfair_Display'] text-5xl md:text-6xl lg:text-7xl font-bold mb-6 bg-gradient-to-r from-white via-amber-200 to-amber-400 bg-clip-text text-transparent">
        Dòng thời gian lịch sử
      </h2>
      <p class="text-xl md:text-2xl text-neutral-400 max-w-3xl mx-auto font-light">
        Hành trình từ thống nhất đến đổi mới <span class="text-amber-300">(1975-1986)</span>
      </p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative">
      <!-- Center Line -->
      <div class="absolute left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-transparent via-amber-500/50 to-transparent hidden md:block -translate-x-1/2"></div>

      <!-- Timeline Items -->
      <div class="space-y-16 md:space-y-24">
        {timelineData.map((event, index) => (
          <div class={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} gap-8 md:gap-16 items-center group`}>
            <!-- Marker -->
            <div class="hidden md:block absolute left-1/2 top-8 -translate-x-1/2 w-6 h-6 bg-gradient-to-br from-amber-400 to-yellow-600 rounded-full border-4 border-stone-900 shadow-xl shadow-amber-500/40 z-10 group-hover:scale-125 transition-transform duration-300"></div>

            <!-- Content Card -->
            <div class="flex-1 md:w-1/2">
              <a href={`/timeline/${event.year}-${slugify(event.title)}`} class="block">
                <div class={`relative bg-gradient-to-br from-stone-800/50 to-stone-900/50 backdrop-blur-xl border border-amber-500/20 rounded-3xl overflow-hidden shadow-2xl hover:shadow-amber-500/20 hover:border-amber-500/40 hover:-translate-y-2 transition-all duration-500 group/card ${index % 2 === 0 ? 'md:text-right md:mr-8' : 'md:ml-8'}`}>
                  
                  <!-- Event Image -->
                  {event.image && (
                    <div class="relative h-48 md:h-56 overflow-hidden rounded-t-3xl" data-timeline-image-wrapper onclick={`return false;`}>
                      <ImageZoom 
                        src={event.image} 
                        alt={event.title}
                        thumbnail={true}
                        class="w-full h-full relative z-10"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-stone-900 to-transparent opacity-80 pointer-events-none z-0"></div>
                    </div>
                  )}
                  
                  <div class="p-8">
                  
                  <!-- Card Header -->
                  <div class={`flex ${index % 2 === 0 ? 'md:justify-end' : 'md:justify-start'} justify-between items-center mb-6 gap-4`}>
                    <span class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-amber-400 to-yellow-500 bg-clip-text text-transparent font-['Playfair_Display']">
                      {event.year}
                    </span>
                    <span class="px-4 py-2 bg-amber-500/10 rounded-2xl border border-amber-500/30 text-amber-300">
                      <Icon name={event.category === 'economic' ? 'chart-bar' : event.category === 'political' ? 'briefcase' : event.category === 'social' ? 'users' : 'book'} class="w-6 h-6" />
                    </span>
                  </div>

                  <!-- Title -->
                  <h3 class="text-2xl md:text-3xl font-bold mb-4 text-white group-hover/card:text-amber-200 transition-colors duration-300">
                    {event.title}
                  </h3>

                  <!-- Description -->
                  <p class="text-neutral-300 leading-relaxed mb-6 text-base md:text-lg">
                    {event.description}
                  </p>

                  <!-- Keywords -->
                  <div class={`flex flex-wrap gap-2 ${index % 2 === 0 ? 'md:justify-end' : 'md:justify-start'}`}>
                    {event.keywords.map(keyword => (
                      <span class="px-4 py-1.5 bg-amber-500/15 border border-amber-500/30 rounded-full text-sm text-amber-300 font-medium">
                        {keyword}
                      </span>
                    ))}
                  </div>

                  <!-- Importance Badge -->
                  {event.importance === 'high' && (
                    <div class={`mt-6 inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-amber-500/20 to-yellow-500/20 border border-amber-400/40 rounded-full text-amber-300 font-semibold text-sm`}>
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 16 16">
                        <path d="M8 0L10 5.5H16L11 8.5L13 14L8 10.5L3 14L5 8.5L0 5.5H6L8 0Z"/>
                      </svg>
                      Sự kiện quan trọng
                    </div>
                  )}
                  </div>
                </div>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Summary Card -->
    <div class="mt-32 max-w-4xl mx-auto text-center">
      <div class="relative bg-gradient-to-br from-amber-900/20 to-yellow-900/10 backdrop-blur-xl border-2 border-amber-500/30 rounded-3xl p-10 md:p-16 shadow-2xl">
        <div class="absolute -top-6 left-1/2 -translate-x-1/2 px-6 py-2 bg-gradient-to-r from-amber-500 to-yellow-600 rounded-full text-stone-950 font-bold text-sm uppercase tracking-wider shadow-xl">
          Tổng kết
        </div>
        <h3 class="font-['Playfair_Display'] text-3xl md:text-4xl font-bold mb-6 text-amber-300">
          Tổng kết giai đoạn
        </h3>
        <p class="text-lg md:text-xl text-neutral-200 leading-relaxed">
          11 năm kinh tế bao cấp đã để lại những bài học quý giá về việc xây dựng mô hình kinh tế phù hợp với điều kiện đất nước. <span class="text-amber-300 font-semibold">Đổi Mới 1986</span> mở ra thời kỳ phát triển mới của Việt Nam.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }
</style>
