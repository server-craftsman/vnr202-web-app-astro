---
import type { TimelineEvent } from '../data/timeline';
import { timelineData } from '../data/timeline';
---

<section class="timeline-section" id="timeline">
	<div class="container">
		<div class="section-header">
			<h2 class="section-title">Dòng thời gian lịch sử</h2>
			<p class="section-subtitle">Hành trình từ thống nhất đến đổi mới (1975-1986)</p>
		</div>
		
		<div class="timeline-wrapper">
			<div class="timeline-line"></div>
			
			{timelineData.map((event, index) => (
				<div class={`timeline-item ${index % 2 === 0 ? 'left' : 'right'}`} data-year={event.year}>
					<div class="timeline-content">
						<div class="timeline-marker"></div>
						<div class="timeline-card">
							<div class="card-header">
								<span class="year-badge">{event.year}</span>
								<span class="category-badge category-{event.category}">
									{event.category === 'economic' ? '💰' : event.category === 'political' ? '🏛️' : event.category === 'social' ? '👥' : '📖'}
								</span>
							</div>
							<h3 class="card-title">{event.title}</h3>
							<p class="card-description">{event.description}</p>
							<div class="card-keywords">
								{event.keywords.map(keyword => (
									<span class="keyword-tag">{keyword}</span>
								))}
							</div>
							{event.importance === 'high' && (
								<div class="importance-badge">
									<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
										<path d="M8 0L10 5.5H16L11 8.5L13 14L8 10.5L3 14L5 8.5L0 5.5H6L8 0Z" fill="currentColor"/>
									</svg>
									Sự kiện quan trọng
								</div>
							)}
						</div>
					</div>
				</div>
			))}
		</div>
		
		<div class="timeline-summary">
			<div class="summary-card">
				<h3>Tổng kết giai đoạn</h3>
				<p>11 năm kinh tế bao cấp đã để lại những bài học quý giá về việc xây dựng mô hình kinh tế phù hợp với điều kiện đất nước. Đổi Mới 1986 mở ra thời kỳ phát triển mới của Việt Nam.</p>
			</div>
		</div>
	</div>
</section>

<style>
	.timeline-section {
		position: relative;
		padding: 8rem 2rem;
		background: linear-gradient(180deg, #1a1a1a 0%, #2d2d2d 100%);
		min-height: 100vh;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.section-header {
		text-align: center;
		margin-bottom: 6rem;
		animation: fadeInUp 0.8s ease-out;
	}

	.section-title {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 700;
		margin-bottom: 1rem;
		background: linear-gradient(135deg, #ffffff 0%, #d4af37 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.section-subtitle {
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.7);
		max-width: 600px;
		margin: 0 auto;
	}

	.timeline-wrapper {
		position: relative;
		padding: 2rem 0;
	}

	.timeline-line {
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 3px;
		background: linear-gradient(180deg, transparent 0%, #d4af37 20%, #d4af37 80%, transparent 100%);
		transform: translateX(-50%);
	}

	.timeline-item {
		position: relative;
		width: 50%;
		padding: 2rem;
		opacity: 0;
		animation: fadeInSide 0.8s ease-out forwards;
	}

	.timeline-item:nth-child(odd) {
		animation-delay: var(--delay, 0.1s);
	}

	.timeline-item:nth-child(even) {
		animation-delay: var(--delay, 0.1s);
	}

	@keyframes fadeInSide {
		from {
			opacity: 0;
			transform: translateX(var(--direction, -30px));
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	.timeline-item.left {
		left: 0;
		padding-right: 4rem;
		--direction: -30px;
	}

	.timeline-item.right {
		left: 50%;
		padding-left: 4rem;
		--direction: 30px;
		--delay: 0.2s;
	}

	.timeline-content {
		position: relative;
	}

	.timeline-marker {
		position: absolute;
		width: 20px;
		height: 20px;
		background: #d4af37;
		border: 4px solid #1a1a1a;
		border-radius: 50%;
		top: 2rem;
	}

	.timeline-item.left .timeline-marker {
		right: -3.8rem;
	}

	.timeline-item.right .timeline-marker {
		left: -3.8rem;
	}

	.timeline-card {
		background: rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 20px;
		padding: 2rem;
		transition: all 0.3s ease;
		cursor: pointer;
		position: relative;
		overflow: hidden;
	}

	.timeline-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, #d4af37, #f4bf37);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s ease;
	}

	.timeline-card:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(212, 175, 55, 0.5);
		transform: translateY(-5px);
		box-shadow: 0 20px 40px rgba(212, 175, 55, 0.2);
	}

	.timeline-card:hover::before {
		transform: scaleX(1);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
	}

	.year-badge {
		font-size: 1.5rem;
		font-weight: 700;
		color: #d4af37;
	}

	.category-badge {
		font-size: 1.5rem;
		padding: 0.5rem;
		background: rgba(212, 175, 55, 0.1);
		border-radius: 8px;
	}

	.card-title {
		font-size: 1.5rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
		color: #fff;
		line-height: 1.3;
	}

	.card-description {
		color: rgba(255, 255, 255, 0.7);
		line-height: 1.8;
		margin-bottom: 1rem;
	}

	.card-keywords {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.keyword-tag {
		font-size: 0.875rem;
		padding: 0.25rem 0.75rem;
		background: rgba(212, 175, 55, 0.15);
		border: 1px solid rgba(212, 175, 55, 0.3);
		border-radius: 20px;
		color: #d4af37;
	}

	.importance-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: linear-gradient(135deg, rgba(212, 175, 55, 0.2), rgba(244, 191, 55, 0.2));
		border: 1px solid rgba(212, 175, 55, 0.4);
		border-radius: 20px;
		font-size: 0.875rem;
		color: #d4af37;
		font-weight: 600;
	}

	.timeline-summary {
		margin-top: 6rem;
		text-align: center;
		animation: fadeInUp 1s ease-out;
	}

	.summary-card {
		background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(244, 191, 55, 0.05));
		border: 2px solid rgba(212, 175, 55, 0.3);
		border-radius: 30px;
		padding: 3rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.summary-card h3 {
		font-family: 'Playfair Display', serif;
		font-size: 2rem;
		margin-bottom: 1.5rem;
		color: #d4af37;
	}

	.summary-card p {
		font-size: 1.125rem;
		line-height: 1.8;
		color: rgba(255, 255, 255, 0.9);
	}

	@media (max-width: 968px) {
		.timeline-line {
			left: 30px;
		}

		.timeline-item {
			width: 100%;
			left: 0 !important;
			padding-left: 5rem !important;
			padding-right: 2rem !important;
		}

		.timeline-marker {
			left: -1.8rem !important;
			right: auto !important;
		}
	}

	@media (max-width: 640px) {
		.timeline-section {
			padding: 4rem 1rem;
		}

		.section-header {
			margin-bottom: 3rem;
		}

		.timeline-item {
			padding: 1rem;
			padding-left: 3rem !important;
		}

		.timeline-marker {
			left: -0.9rem !important;
			width: 15px;
			height: 15px;
		}

		.card-title {
			font-size: 1.25rem;
		}

		.summary-card {
			padding: 2rem 1.5rem;
		}
	}
</style>

<script>
	// Intersection Observer for timeline animations
	if (typeof window !== 'undefined') {
		const observerOptions = {
			threshold: 0.2,
			rootMargin: '0px 0px -50px 0px'
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry, index) => {
				if (entry.isIntersecting) {
					entry.target.setAttribute('style', `--delay: ${index * 0.1}s;`);
					entry.target.classList.add('animated');
				}
			});
		}, observerOptions);

		document.querySelectorAll('.timeline-item').forEach((item) => {
			observer.observe(item);
		});
	}
</script>
