---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = "Bảo Tàng Thời Bao Cấp",
  description = "Trải nghiệm tương tác về thời kỳ kinh tế bao cấp Việt Nam 1975-1986. Khám phá lịch sử, hiện vật và câu chuyện về giai đoạn 1975-1986",
  image = "/assets/bg2.jpg",
  url = Astro.url.href,
} = Astro.props;

const siteUrl = Astro.site || "https://vnr202-web-app-astro.pages.dev";
const fullImageUrl = image.startsWith("http")
  ? image
  : siteUrl + (image.startsWith("/") ? image : "/" + image);
const fullUrl = url.startsWith("http")
  ? url
  : siteUrl + (url.startsWith("/") ? url : "/" + url);

import "../styles/tailwind.css";
import AudioToggle from "../components/AudioToggle.astro";
import ScrollAnimations from "../components/ScrollAnimations.astro";
import { ViewTransitions } from "astro:transitions";
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:site_name" content="Bảo Tàng Thời Bao Cấp" />
    <meta property="og:locale" content="vi_VN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="theme-color" content="#d4af37" />

    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-gradient-to-b from-neutral-950 via-neutral-900 to-neutral-800 text-white antialiased selection:bg-yellow-300/20 selection:text-yellow-100"
  >
    <slot />
    <AudioToggle />
    <ScrollAnimations />
  </body>
</html>

<script is:inline>
  // Persistent audio across ALL pages - runs immediately
  (function () {
    const AUDIO_KEY = "baocap_audio_state";

    // Check if audio already exists globally
    if (!window.__baocapAudio__) {
      // Create audio element ONCE with persistence
      const audio = document.createElement("audio");
      audio.id = "ambient-audio";
      audio.src = "/music-for-victory-parade.mp3";
      audio.loop = true;
      audio.preload = "auto";
      audio.style.display = "none";
      audio.setAttribute("data-astro-transition-persist", "audio-player");

      // Append to body immediately
      if (document.body) {
        document.body.appendChild(audio);
      } else {
        document.addEventListener("DOMContentLoaded", () => {
          document.body.appendChild(audio);
        });
      }

      // Store globally to survive navigation
      window.__baocapAudio__ = audio;

      // Prevent audio from being paused during transitions
      audio.addEventListener(
        "pause",
        (e) => {
          const savedState = localStorage.getItem(AUDIO_KEY);
          if (savedState) {
            try {
              const state = JSON.parse(savedState);
              // If audio was playing and got paused, resume immediately
              if (state.isPlaying && audio.paused) {
                // Resume immediately without delay
                audio.play().catch(() => {});
              }
            } catch (e) {}
          }
        },
        { passive: true }
      );

      // Restore state from localStorage
      const savedState = localStorage.getItem(AUDIO_KEY);
      if (savedState) {
        try {
          const state = JSON.parse(savedState);
          audio.volume = state.volume || 0.7;

          if (state.currentTime && audio.duration > 0) {
            audio.currentTime = state.currentTime;
          }

          // Restore playing state - try to auto-resume if it was playing
          if (state.isPlaying) {
            // Play immediately - no delays, no checks
            const tryResume = () => {
              if (audio && audio.paused) {
                audio.play().catch(() => {
                  // Auto-play blocked, will need user interaction
                });
              }
              // Double-check: ensure it's playing
              if (audio && audio.paused) {
                audio.play().catch(() => {});
              }
            };

            // Try immediately - no conditions
            tryResume();

            // Also try when audio is ready (if not already)
            if (audio.readyState < 2) {
              audio.addEventListener("canplaythrough", tryResume, {
                once: true,
              });
              audio.addEventListener("loadeddata", tryResume, { once: true });
            }
          }
        } catch (e) {
          console.log("Could not restore audio state:", e);
        }
      } else {
        // Default volume
        audio.volume = 0.7;
      }
    }

    // Save state periodically and before unload
    function saveAudioState() {
      const audio = window.__baocapAudio__;
      if (audio) {
        const state = {
          isPlaying: !audio.paused,
          volume: audio.volume,
          currentTime: audio.currentTime,
        };
        localStorage.setItem(AUDIO_KEY, JSON.stringify(state));
      }
    }

    // Save every 5 seconds if playing
    setInterval(() => {
      const audio = window.__baocapAudio__;
      if (audio && !audio.paused) {
        saveAudioState();
      }
    }, 5000);

    // Continuous monitoring to ensure audio keeps playing during page transitions
    setInterval(() => {
      const audio = window.__baocapAudio__;
      if (!audio) return;

      const savedState = localStorage.getItem(AUDIO_KEY);
      if (savedState) {
        try {
          const state = JSON.parse(savedState);
          // If audio should be playing but is paused, resume immediately
          if (state.isPlaying && audio.paused) {
            // Resume immediately - no delay
            audio.play().catch(() => {});
          }
        } catch (e) {}
      }
    }, 100); // Check every 100ms to ensure continuous playback

    // Save before unload
    window.addEventListener("beforeunload", saveAudioState);
    window.addEventListener("pagehide", saveAudioState);

    // Handle View Transitions - prevent audio pause and ensure continuous playback
    document.addEventListener("astro:before-preparation", () => {
      // Save state right before page transition
      const audio = window.__baocapAudio__;
      if (audio && !audio.paused) {
        saveAudioState();
        // CRITICAL: Prevent audio from pausing during transition
        // Add listener to immediately resume if paused
        const preventPause = () => {
          if (!audio.paused) {
            // Audio is still playing - save current state
            saveAudioState();
          } else {
            // Audio was paused - resume immediately
            const savedState = localStorage.getItem(AUDIO_KEY);
            if (savedState) {
              try {
                const state = JSON.parse(savedState);
                if (state.isPlaying) {
                  audio.currentTime = state.currentTime || audio.currentTime;
                  audio.play().catch(() => {});
                }
              } catch (e) {}
            }
          }
        };

        // Listen for pause events and immediately resume
        audio.addEventListener("pause", preventPause, { passive: true });

        // Also check immediately before transition
        if (audio.paused) {
          preventPause();
        }
      }
    });

    document.addEventListener("astro:page-load", () => {
      const audio = window.__baocapAudio__;
      if (!audio) return;

      // IMMEDIATELY restore audio - NO DELAY, NO WAITING
      const savedState = localStorage.getItem(AUDIO_KEY);
      if (savedState) {
        try {
          const state = JSON.parse(savedState);

          // Restore volume immediately
          audio.volume = state.volume || 0.7;

          // Restore current time immediately if valid
          if (state.currentTime && audio.duration > 0) {
            audio.currentTime = state.currentTime;
          }

          // CRITICAL: If it was playing, resume IMMEDIATELY - NO DELAY, NO CHECKS
          if (state.isPlaying) {
            // Play immediately - don't wait for anything
            audio.play().catch(() => {
              // Auto-play might be blocked, but try anyway
            });

            // Double-check: ensure it's playing
            if (audio.paused) {
              audio.play().catch(() => {});
            }

            // Triple-check after microtask
            Promise.resolve().then(() => {
              if (audio.paused && state.isPlaying) {
                audio.play().catch(() => {});
              }
            });
          }
        } catch (e) {
          console.log("Could not restore audio on page load:", e);
        }
      }

      // Continuous monitoring to ensure audio keeps playing
      const checkAndResume = () => {
        const audio = window.__baocapAudio__;
        if (!audio) return;

        const savedState = localStorage.getItem(AUDIO_KEY);
        if (savedState) {
          try {
            const state = JSON.parse(savedState);
            // If audio should be playing but is paused, resume immediately
            if (state.isPlaying && audio.paused) {
              // Resume immediately - no delay
              audio.play().catch(() => {});
            }
          } catch (e) {}
        }
      };

      // Check immediately - multiple times to ensure it resumes
      checkAndResume();
      requestAnimationFrame(checkAndResume);
      requestAnimationFrame(() => requestAnimationFrame(checkAndResume));

      // Also set up continuous monitoring for this page
      const monitorInterval = setInterval(() => {
        checkAndResume();
        // Stop monitoring if audio is not supposed to be playing
        const savedState = localStorage.getItem(AUDIO_KEY);
        if (savedState) {
          try {
            const state = JSON.parse(savedState);
            if (!state.isPlaying) {
              clearInterval(monitorInterval);
            }
          } catch (e) {
            clearInterval(monitorInterval);
          }
        } else {
          clearInterval(monitorInterval);
        }
      }, 50); // Check every 50ms on page load to catch any immediate pauses
    });
  })();

  // Ensure all internal links use View Transitions (no full page reload)
  (function () {
    // Intercept all link clicks to ensure View Transitions are used
    document.addEventListener(
      "click",
      function (e) {
        const target = e.target;
        const link = target.closest ? target.closest("a[href]") : null;

        if (!link) return;

        const href = link.getAttribute("href");
        if (!href) return;

        // Skip external links, mailto, tel, and anchor-only links
        if (
          href.startsWith("http://") ||
          href.startsWith("https://") ||
          href.startsWith("mailto:") ||
          href.startsWith("tel:") ||
          href.startsWith("#")
        ) {
          // For anchor links, use smooth scroll without page reload
          if (href.startsWith("#")) {
            e.preventDefault();
            const targetId = href.substring(1);
            const targetElement =
              document.getElementById(targetId) ||
              document.querySelector('[id="' + targetId + '"]');
            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
              // Update URL without reload
              history.pushState(null, "", href);
            }
          }
          return;
        }

        // For internal links, ensure View Transitions are used (no full reload)
        // Check if link has target="_blank" or other attributes that bypass View Transitions
        if (
          link.hasAttribute("target") &&
          link.getAttribute("target") !== "_self"
        ) {
          return; // Skip links that should open in new window
        }

        // Ensure audio continues playing during transition
        // Astro automatically handles View Transitions for internal links
        // We just ensure audio state is saved before navigation
        const audio = window.__baocapAudio__;
        if (audio && !audio.paused) {
          const state = {
            isPlaying: true,
            volume: audio.volume,
            currentTime: audio.currentTime,
          };
          localStorage.setItem("baocap_audio_state", JSON.stringify(state));
        }

        // Let Astro handle View Transitions - don't prevent default for internal links
      },
      true
    ); // Use capture phase to catch links early
  })();
</script>
