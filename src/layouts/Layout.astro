---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = "Bảo Tàng Thời Bao Cấp",
  description = "Trải nghiệm tương tác về thời kỳ kinh tế bao cấp Việt Nam 1975-1986. Khám phá lịch sử, hiện vật và câu chuyện về giai đoạn 1975-1986",
  image = "/assets/bg2.jpg",
  url = Astro.url.href,
} = Astro.props;

const siteUrl = Astro.site || "https://vnr202-web-app-astro.pages.dev";
const fullImageUrl = image.startsWith("http")
  ? image
  : siteUrl + (image.startsWith("/") ? image : "/" + image);
const fullUrl = url.startsWith("http")
  ? url
  : siteUrl + (url.startsWith("/") ? url : "/" + url);

import "../styles/tailwind.css";
import AudioToggle from "../components/AudioToggle.astro";
import ScrollAnimations from "../components/ScrollAnimations.astro";
import { ViewTransitions } from "astro:transitions";
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:site_name" content="Bảo Tàng Thời Bao Cấp" />
    <meta property="og:locale" content="vi_VN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="theme-color" content="#d4af37" />

    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-gradient-to-b from-neutral-950 via-neutral-900 to-neutral-800 text-white antialiased selection:bg-yellow-300/20 selection:text-yellow-100"
  >
    <slot />
    <AudioToggle />
    <ScrollAnimations />
  </body>
</html>

<script is:inline>
  // Persistent audio across ALL pages - runs immediately
  (function () {
    const AUDIO_KEY = "baocap_audio_state";
    const AUDIO_KEY_SESSION = "baocap_audio_state_session";

    // Helper function to get audio state from storage (localStorage with sessionStorage fallback)
    function getAudioState() {
      try {
        const localState = localStorage.getItem(AUDIO_KEY);
        if (localState) {
          return JSON.parse(localState);
        }
      } catch (e) {}

      try {
        const sessionState = sessionStorage.getItem(AUDIO_KEY_SESSION);
        if (sessionState) {
          return JSON.parse(sessionState);
        }
      } catch (e) {}

      return null;
    }

    // Helper function to save audio state to both storages
    function saveAudioStateToStorage(state) {
      try {
        localStorage.setItem(AUDIO_KEY, JSON.stringify(state));
      } catch (e) {}
      try {
        sessionStorage.setItem(AUDIO_KEY_SESSION, JSON.stringify(state));
      } catch (e) {}
    }

    // Check if audio already exists globally or in DOM
    let audio = window.__baocapAudio__;

    // If not in global, check if it exists in DOM (from previous page)
    if (!audio) {
      audio = document.getElementById("ambient-audio");
      if (audio) {
        // Found existing audio element, reuse it
        window.__baocapAudio__ = audio;
      }
    }

    if (!audio) {
      // Create audio element ONCE with persistence
      audio = document.createElement("audio");
      audio.id = "ambient-audio";
      audio.src = "/music-for-victory-parade-1.mp3";
      audio.loop = true;
      audio.preload = "auto";
      audio.style.display = "none";
      audio.setAttribute("data-astro-transition-persist", "audio-player");

      // CRITICAL: Prevent ANY interference with audio playback
      audio.setAttribute("playsinline", "");
      audio.setAttribute("webkit-playsinline", "");

      // Append to body immediately
      if (document.body) {
        document.body.appendChild(audio);
      } else {
        document.addEventListener("DOMContentLoaded", () => {
          document.body.appendChild(audio);
        });
      }

      // Store globally to survive navigation
      window.__baocapAudio__ = audio;
    } else {
      // Audio already exists, just make sure it's in global
      window.__baocapAudio__ = audio;
    }

    // Now setup all the handlers on the audio element (whether new or existing)
    if (!audio.__setupComplete) {
      // CRITICAL: Monitor currentTime to detect when it resets to 0 and restore immediately
      let lastKnownCurrentTime = 0;
      const monitorCurrentTime = setInterval(() => {
        if (audio) {
          const state = getAudioState();
          if (state && state.isPlaying && state.currentTime > 0) {
            // If currentTime suddenly dropped to near 0 (less than 0.5s) but we have saved time > 1s
            // This means audio was reset - restore immediately!
            if (
              audio.currentTime < 0.5 &&
              state.currentTime > 1 &&
              lastKnownCurrentTime > 1
            ) {
              // Restore immediately - audio was reset!
              if (audio.readyState >= 2 && audio.duration > 0) {
                audio.currentTime = state.currentTime;
                if (audio.paused) {
                  audio.play().catch(() => {});
                }
              } else {
                // Wait for metadata
                const restoreWhenReady = () => {
                  if (
                    audio.duration > 0 &&
                    state.currentTime < audio.duration
                  ) {
                    audio.currentTime = state.currentTime;
                    if (audio.paused) {
                      audio.play().catch(() => {});
                    }
                  }
                };
                audio.addEventListener("loadedmetadata", restoreWhenReady, {
                  once: true,
                });
                audio.addEventListener("canplay", restoreWhenReady, {
                  once: true,
                });
              }
            }
            // Update last known time
            if (audio.currentTime > 0.5) {
              lastKnownCurrentTime = audio.currentTime;
            }
          }
        }
      }, 100); // Check every 100ms

      // CRITICAL: COMPLETELY BLOCK pause() - NEVER ALLOW PAUSING
      const originalPause = audio.pause.bind(audio);
      audio.pause = function () {
        // ABSOLUTELY DO NOT PAUSE - EVER!
        // Immediately resume if somehow paused
        setTimeout(() => {
          if (this.paused) {
            this.play().catch(() => {});
          }
        }, 0);
        // Don't call original pause at all - just return
        return;
      };

      // CRITICAL: Also prevent stop method if it exists - NEVER ALLOW STOPPING
      if (audio.stop) {
        const originalStop = audio.stop.bind(audio);
        audio.stop = function () {
          // NEVER stop - always keep playing
          return;
        };
      }

      // CRITICAL: Auto-start audio immediately and keep it playing FOREVER
      const autoStartAndKeepPlaying = () => {
        // Always set state as playing
        const currentState = {
          isPlaying: true, // ALWAYS TRUE
          volume: audio.volume || 0.7,
          currentTime: audio.currentTime || 0,
        };
        saveAudioStateToStorage(currentState);

        // Try to play if not playing
        if (audio.paused) {
          audio.play().catch(() => {
            // Autoplay might be blocked, keep trying
          });
        }
      };

      // Start immediately
      autoStartAndKeepPlaying();

      // Keep checking every 500ms to ensure always playing
      setInterval(autoStartAndKeepPlaying, 500);

      // Override load() to prevent resetting currentTime and pausing
      const originalLoad = audio.load.bind(audio);
      audio.load = function () {
        const state = getAudioState();
        const wasPlaying = state ? state.isPlaying : false;
        const savedCurrentTime = state ? state.currentTime : 0;

        // Only allow load if audio is truly broken or user explicitly wants to reload
        // Otherwise, prevent load to maintain currentTime
        if (!wasPlaying && !state) {
          // Only load if audio wasn't playing and no state exists
          originalLoad.call(this);
          return;
        }

        // If audio was playing, DON'T call load() - it will reset currentTime
        // Instead, just ensure it continues playing
        if (wasPlaying && savedCurrentTime > 0) {
          // Restore currentTime after a micro delay to ensure audio is ready
          const restoreAfterLoad = () => {
            if (this.readyState >= 2) {
              // Audio is loaded enough to set currentTime
              this.currentTime = savedCurrentTime;
              this.play().catch(() => {});
            } else {
              // Wait for audio to be ready
              this.addEventListener(
                "canplay",
                () => {
                  this.currentTime = savedCurrentTime;
                  this.play().catch(() => {});
                },
                { once: true }
              );
            }
          };

          // Only call original load if absolutely necessary
          originalLoad.call(this);

          // Restore currentTime as soon as possible
          setTimeout(restoreAfterLoad, 0);
          this.addEventListener("loadeddata", restoreAfterLoad, { once: true });
          this.addEventListener("canplay", restoreAfterLoad, { once: true });
        } else {
          originalLoad.call(this);
        }
      };

      // AGGRESSIVE: Prevent pause event from EVER firing if audio should be playing
      const preventPauseHandler = (e) => {
        e.preventDefault();
        e.stopImmediatePropagation();

        const state = getAudioState();
        if (state && state.isPlaying) {
          // Resume IMMEDIATELY - NO DELAY AT ALL
          audio.play().catch(() => {});
          audio.play().catch(() => {});
          audio.play().catch(() => {});

          // Also use all async methods to ensure it resumes
          Promise.resolve().then(() => {
            if (audio.paused && state.isPlaying) {
              audio.play().catch(() => {});
              audio.play().catch(() => {});
            }
          });

          requestAnimationFrame(() => {
            if (audio.paused && state.isPlaying) {
              audio.play().catch(() => {});
              audio.play().catch(() => {});
            }
          });

          if (window.requestIdleCallback) {
            requestIdleCallback(
              () => {
                if (audio.paused && state.isPlaying) {
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});
                }
              },
              { timeout: 0 }
            );
          }

          return false;
        }
      };

      // Add multiple listeners with different phases and priorities
      audio.addEventListener("pause", preventPauseHandler, {
        passive: false,
        capture: true,
        once: false,
      });

      // Also add to the event target phase
      audio.addEventListener("pause", preventPauseHandler, {
        passive: false,
        capture: false,
        once: false,
      });

      // ALWAYS set state as playing on initialization
      let state = getAudioState();
      if (!state) {
        state = {
          isPlaying: true, // Force always playing
          volume: 0.7,
          currentTime: 0,
        };
      } else {
        state.isPlaying = true; // Override to always playing
      }
      saveAudioStateToStorage(state);

      audio.volume = state.volume || 0.7;

      // CRITICAL: Restore currentTime IMMEDIATELY, even if audio isn't fully loaded
      // This prevents audio from restarting from the beginning
      const restoreCurrentTime = () => {
        if (state.currentTime) {
          // Try to set currentTime immediately
          try {
            if (audio.readyState >= 2) {
              // Audio metadata is loaded, can set currentTime
              audio.currentTime = state.currentTime;
            } else {
              // Wait for metadata to load
              const setTimeWhenReady = () => {
                if (audio.duration > 0 && state.currentTime < audio.duration) {
                  audio.currentTime = state.currentTime;
                }
              };
              audio.addEventListener("loadedmetadata", setTimeWhenReady, {
                once: true,
              });
              audio.addEventListener("loadeddata", setTimeWhenReady, {
                once: true,
              });
              audio.addEventListener("canplay", setTimeWhenReady, {
                once: true,
              });
            }
          } catch (e) {
            // Fallback: try again when ready
            audio.addEventListener(
              "canplay",
              () => {
                if (audio.duration > 0 && state.currentTime < audio.duration) {
                  audio.currentTime = state.currentTime;
                }
              },
              { once: true }
            );
          }
        }
      };

      // Restore currentTime immediately
      restoreCurrentTime();

      // CRITICAL: Set initial lastKnownCurrentTime
      if (state.currentTime) {
        lastKnownCurrentTime = state.currentTime;
      }

      // ALWAYS start playing - no conditions!
      // Force state to always playing
      state.isPlaying = true;
      saveAudioStateToStorage(state);
      // Play immediately - no delays, no checks
      const tryResume = () => {
        // First ensure currentTime is restored - CRITICAL to do this BEFORE playing
        if (state.currentTime && state.currentTime > 0) {
          if (audio.readyState >= 2 && audio.duration > 0) {
            // Audio is ready, set currentTime immediately
            if (state.currentTime < audio.duration) {
              audio.currentTime = state.currentTime;
              lastKnownCurrentTime = state.currentTime;
            }
          } else {
            // Wait for metadata, but set as soon as possible
            const setTimeAndPlay = () => {
              if (audio.duration > 0 && state.currentTime < audio.duration) {
                audio.currentTime = state.currentTime;
                lastKnownCurrentTime = state.currentTime;
              }
              if (audio && audio.paused) {
                audio.play().catch(() => {});
              }
            };
            audio.addEventListener("loadedmetadata", setTimeAndPlay, {
              once: true,
            });
            audio.addEventListener("loadeddata", setTimeAndPlay, {
              once: true,
            });
            audio.addEventListener("canplay", setTimeAndPlay, {
              once: true,
            });
          }
        }

        if (audio && audio.paused) {
          // Only play if currentTime is already set (or audio not ready yet)
          if (audio.readyState >= 2 && state.currentTime) {
            // Ensure currentTime is set before playing
            if (
              audio.currentTime !== state.currentTime &&
              state.currentTime < audio.duration
            ) {
              audio.currentTime = state.currentTime;
            }
          }
          audio.play().catch(() => {
            // Auto-play blocked, will need user interaction
          });
        }
        // Double-check: ensure it's playing
        if (audio && audio.paused) {
          audio.play().catch(() => {});
        }
      };

      // Try immediately - no conditions
      tryResume();

      // Also try when audio is ready (if not already)
      if (audio.readyState < 2) {
        audio.addEventListener("canplaythrough", tryResume, {
          once: true,
        });
        audio.addEventListener("loadeddata", tryResume, { once: true });
        audio.addEventListener("canplay", tryResume, { once: true });
        audio.addEventListener("loadedmetadata", tryResume, { once: true });
      }

      // Add visibilitychange listener to resume audio when tab becomes visible
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden && audio) {
          const state = getAudioState();
          if (state && state.isPlaying && audio.paused) {
            // Resume audio when tab becomes visible if it should be playing
            audio.play().catch(() => {});
            audio.play().catch(() => {});
          }
        }
      });

      // Add focus listener as backup
      window.addEventListener("focus", () => {
        if (audio) {
          const state = getAudioState();
          if (state && state.isPlaying && audio.paused) {
            audio.play().catch(() => {});
            audio.play().catch(() => {});
          }
        }
      });

      // Mark setup as complete so we don't duplicate handlers
      audio.__setupComplete = true;
    }

    // Save state periodically and before unload
    function saveAudioState() {
      const audio = window.__baocapAudio__;
      if (audio) {
        // Save currentTime more frequently to prevent loss during transitions
        // Use lastKnownCurrentTime as fallback if currentTime was reset
        const currentTimeToSave =
          audio.currentTime > 0.5
            ? audio.currentTime
            : lastKnownCurrentTime || 0;
        const state = {
          isPlaying: true, // ALWAYS TRUE - force always playing
          volume: audio.volume,
          currentTime: currentTimeToSave,
        };
        saveAudioStateToStorage(state);
      }
    }

    // Save every 1 second if playing (more frequent to catch currentTime changes)
    setInterval(() => {
      const audio = window.__baocapAudio__;
      if (audio && !audio.paused) {
        saveAudioState();
      }
    }, 1000);

    // Also save currentTime continuously even when paused (to track position)
    setInterval(() => {
      const audio = window.__baocapAudio__;
      if (audio && audio.currentTime > 0) {
        const state = getAudioState();
        if (state) {
          state.currentTime = audio.currentTime;
          saveAudioStateToStorage(state);
        }
      }
    }, 500); // Save every 500ms to track position

    // ULTRA AGGRESSIVE: Continuous monitoring to FORCE audio to ALWAYS play
    setInterval(() => {
      const audio = window.__baocapAudio__;
      if (!audio) return;

      // ALWAYS force play if paused - no conditions!
      if (audio.paused) {
        audio.play().catch(() => {});
      }

      // Always ensure state is set to playing
      const state = getAudioState();
      if (!state || !state.isPlaying) {
        saveAudioStateToStorage({
          isPlaying: true,
          volume: audio.volume || 0.7,
          currentTime: audio.currentTime || 0,
        });
      }
    }, 100); // Check every 100ms to ensure continuous playback

    // Save before unload
    window.addEventListener("beforeunload", saveAudioState);
    window.addEventListener("pagehide", saveAudioState);

    // Use MutationObserver to detect if audio element is removed/recreated
    if (window.__baocapAudio__) {
      const audio = window.__baocapAudio__;
      const observer = new MutationObserver((mutations) => {
        const state = getAudioState();
        if (state && state.isPlaying && audio.paused) {
          // Resume immediately if audio was paused during mutation
          audio.play().catch(() => {});
          audio.play().catch(() => {});
          audio.play().catch(() => {});
        }
      });

      observer.observe(document.body || document.documentElement, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ["src", "preload"],
      });
    }

    // Handle View Transitions - prevent audio pause and ensure continuous playback
    document.addEventListener("astro:before-preparation", () => {
      // Save state right before page transition
      const audio = window.__baocapAudio__;
      if (audio) {
        // CRITICAL: Save current state immediately with currentTime
        const currentState = {
          isPlaying: !audio.paused,
          volume: audio.volume,
          currentTime: audio.currentTime || lastKnownCurrentTime || 0,
        };
        saveAudioStateToStorage(currentState);

        const state = getAudioState();
        if (state && state.isPlaying) {
          // Ensure currentTime is preserved
          if (audio.currentTime > 0) {
            state.currentTime = audio.currentTime;
            lastKnownCurrentTime = audio.currentTime;
            saveAudioStateToStorage(state);
          }

          // CRITICAL: Ensure audio continues playing DURING transition
          // DON'T let it pause at all - play multiple times aggressively
          // Play BEFORE any pause can happen - ULTRA AGGRESSIVE
          const keepPlaying = () => {
            if (audio.paused && state.isPlaying) {
              audio.play().catch(() => {});
            }
          };

          // Play immediately multiple times
          for (let i = 0; i < 10; i++) {
            audio.play().catch(() => {});
          }

          // Also schedule plays
          setTimeout(keepPlaying, 0);
          setTimeout(keepPlaying, 10);
          setTimeout(keepPlaying, 50);
          setTimeout(keepPlaying, 100);
          requestAnimationFrame(keepPlaying);
          Promise.resolve().then(keepPlaying);

          // Add aggressive listener to prevent ANY pause during transition
          const preventPauseDuringTransition = (e) => {
            e.preventDefault();
            e.stopImmediatePropagation();

            if (state.isPlaying && audio.paused) {
              // Resume immediately - play multiple times, NO DELAY
              audio.currentTime = state.currentTime || audio.currentTime;
              audio.play().catch(() => {});
              audio.play().catch(() => {});
              audio.play().catch(() => {});

              // Use all async methods
              Promise.resolve().then(() => {
                if (audio.paused && state.isPlaying) {
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});
                }
              });

              requestAnimationFrame(() => {
                if (audio.paused && state.isPlaying) {
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});
                }
              });

              return false;
            }
          };

          // Listen in capture phase to catch pause events early - MULTIPLE LISTENERS
          audio.addEventListener("pause", preventPauseDuringTransition, {
            passive: false,
            capture: true,
            once: false, // Keep listening during entire transition
          });

          // Also in bubble phase
          audio.addEventListener("pause", preventPauseDuringTransition, {
            passive: false,
            capture: false,
            once: false,
          });

          // Also monitor continuously during transition - VERY AGGRESSIVE
          const monitorInterval = setInterval(() => {
            if (state.isPlaying && audio.paused) {
              // Play multiple times to ensure it works
              audio.play().catch(() => {});
              audio.play().catch(() => {});
              audio.play().catch(() => {});
            }
          }, 5); // Check every 5ms during transition - MAXIMUM RESPONSIVENESS

          // Stop monitoring after transition completes
          document.addEventListener(
            "astro:page-load",
            () => {
              clearInterval(monitorInterval);
              audio.removeEventListener("pause", preventPauseDuringTransition, {
                capture: true,
              });
              audio.removeEventListener("pause", preventPauseDuringTransition, {
                capture: false,
              });
            },
            { once: true }
          );
        }
      }
    });

    // Resume audio IMMEDIATELY when page loads (BEFORE astro:page-load)
    function immediateAudioResume() {
      const audio = window.__baocapAudio__;
      if (!audio) {
        return;
      }

      const state = getAudioState();
      if (state) {
        // Restore volume immediately
        audio.volume = state.volume || 0.7;

        // CRITICAL: Restore currentTime IMMEDIATELY, even before audio is fully loaded
        // This prevents audio from restarting from the beginning
        const restoreTimeImmediate = () => {
          if (state.currentTime && state.currentTime > 0) {
            try {
              if (audio.readyState >= 2 && audio.duration > 0) {
                if (state.currentTime < audio.duration) {
                  audio.currentTime = state.currentTime;
                  lastKnownCurrentTime = state.currentTime;
                }
              } else {
                const setTime = () => {
                  if (
                    audio.duration > 0 &&
                    state.currentTime < audio.duration
                  ) {
                    audio.currentTime = state.currentTime;
                    lastKnownCurrentTime = state.currentTime;
                  }
                };
                audio.addEventListener("loadedmetadata", setTime, {
                  once: true,
                });
                audio.addEventListener("loadeddata", setTime, { once: true });
                audio.addEventListener("canplay", setTime, { once: true });
              }
            } catch (e) {
              audio.addEventListener(
                "canplay",
                () => {
                  if (
                    audio.duration > 0 &&
                    state.currentTime < audio.duration
                  ) {
                    audio.currentTime = state.currentTime;
                    lastKnownCurrentTime = state.currentTime;
                  }
                },
                { once: true }
              );
            }
          }
        };

        restoreTimeImmediate();

        // CRITICAL: Update lastKnownCurrentTime
        if (state.currentTime) {
          lastKnownCurrentTime = state.currentTime;
        }

        // CRITICAL: If it was playing, resume IMMEDIATELY - ABSOLUTE NO DELAY
        if (state.isPlaying) {
          // Ensure currentTime is set before playing - CRITICAL!
          if (
            state.currentTime &&
            audio.readyState >= 2 &&
            audio.duration > 0
          ) {
            audio.currentTime = state.currentTime;
            lastKnownCurrentTime = state.currentTime;
          }

          // Play immediately - NO conditions, NO checks, NO delays
          // Play multiple times to ensure it works
          audio.play().catch(() => {});
          audio.play().catch(() => {});
          audio.play().catch(() => {});
          audio.play().catch(() => {});
          audio.play().catch(() => {});

          // Use ALL async methods to ensure it resumes
          Promise.resolve().then(() => {
            if (audio.paused && state.isPlaying) {
              audio.play().catch(() => {});
              audio.play().catch(() => {});
            }
          });

          setTimeout(() => {
            if (audio.paused && state.isPlaying) {
              audio.play().catch(() => {});
              audio.play().catch(() => {});
            }
          }, 0);

          requestAnimationFrame(() => {
            if (audio.paused && state.isPlaying) {
              audio.play().catch(() => {});
              audio.play().catch(() => {});
            }
          });

          if (window.requestIdleCallback) {
            requestIdleCallback(
              () => {
                if (audio.paused && state.isPlaying) {
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});
                }
              },
              { timeout: 0 }
            );
          }
        }
      }
    }

    // Call IMMEDIATELY in ALL possible ways (before View Transitions)

    // 1. Immediately if DOM already ready
    if (document.readyState !== "loading") {
      immediateAudioResume();
    }

    // 2. On DOMContentLoaded (before any other scripts)
    document.addEventListener("DOMContentLoaded", immediateAudioResume, {
      once: true,
      capture: true,
    });

    // 3. On window load
    window.addEventListener("load", immediateAudioResume, {
      once: true,
      capture: true,
    });

    // 4. Immediately in current execution context
    immediateAudioResume();

    // CRITICAL: On astro:after-swap - ensure audio element is reconnected
    document.addEventListener("astro:after-swap", () => {
      let audio = window.__baocapAudio__;

      // Check if audio element still exists in DOM
      const audioInDom = document.getElementById("ambient-audio");
      if (!audioInDom && audio) {
        // Audio element was removed from DOM! Re-append it
        document.body.appendChild(audio);
      } else if (audioInDom && audioInDom !== audio) {
        // Different audio element in DOM - use the one from DOM and update global reference
        window.__baocapAudio__ = audioInDom;
        audio = audioInDom;
      }

      // ALWAYS force playing - AGGRESSIVE
      let state = getAudioState();
      if (!state) {
        state = { isPlaying: true, volume: 0.7, currentTime: 0 };
      }
      state.isPlaying = true; // Force always playing
      saveAudioStateToStorage(state);

      if (state && audio) {
        audio.volume = state.volume || 0.7;

        // Restore currentTime immediately - CRITICAL
        const doRestore = () => {
          if (state.currentTime && state.currentTime > 0) {
            if (
              audio.readyState >= 2 &&
              audio.duration > 0 &&
              state.currentTime < audio.duration
            ) {
              audio.currentTime = state.currentTime;
              lastKnownCurrentTime = state.currentTime;
            }
          }

          // ALWAYS resume - no conditions - ULTRA AGGRESSIVE
          if (audio.paused) {
            for (let i = 0; i < 5; i++) {
              audio.play().catch(() => {});
            }
          }
        };

        // Do restore immediately
        doRestore();

        // Also schedule restores
        setTimeout(doRestore, 0);
        setTimeout(doRestore, 10);
        setTimeout(doRestore, 50);
        requestAnimationFrame(doRestore);
        Promise.resolve().then(doRestore);

        // Add listeners if not ready
        if (audio.readyState < 2) {
          audio.addEventListener("loadedmetadata", doRestore, { once: true });
          audio.addEventListener("canplay", doRestore, { once: true });
          audio.addEventListener("loadeddata", doRestore, { once: true });
        }
      }
    });

    // Also call on astro:page-load for redundancy
    document.addEventListener("astro:page-load", () => {
      const audio = window.__baocapAudio__;
      if (!audio) {
        return;
      }

      // ALWAYS force playing - ABSOLUTE NO DELAY, NO WAITING
      let state = getAudioState();
      if (!state) {
        state = { isPlaying: true, volume: 0.7, currentTime: 0 };
      }
      state.isPlaying = true; // Force always playing
      saveAudioStateToStorage(state);

      // Restore volume immediately
      audio.volume = state.volume || 0.7;

      // CRITICAL: Restore currentTime IMMEDIATELY, even before audio is fully loaded
      // This prevents audio from restarting from the beginning
      const restoreTime = () => {
        if (state.currentTime && state.currentTime > 0) {
          try {
            if (audio.readyState >= 2 && audio.duration > 0) {
              // Audio metadata is loaded, can set currentTime immediately
              if (state.currentTime < audio.duration) {
                audio.currentTime = state.currentTime;
              }
            } else {
              // Wait for metadata, but set as soon as possible
              const setTime = () => {
                if (audio.duration > 0 && state.currentTime < audio.duration) {
                  audio.currentTime = state.currentTime;
                }
              };
              audio.addEventListener("loadedmetadata", setTime, {
                once: true,
              });
              audio.addEventListener("loadeddata", setTime, { once: true });
              audio.addEventListener("canplay", setTime, { once: true });
            }
          } catch (e) {
            // Fallback: try when ready
            audio.addEventListener(
              "canplay",
              () => {
                if (audio.duration > 0 && state.currentTime < audio.duration) {
                  audio.currentTime = state.currentTime;
                }
              },
              { once: true }
            );
          }
        }
      };

      // Restore time immediately
      restoreTime();

      // CRITICAL: Update lastKnownCurrentTime
      if (state.currentTime) {
        lastKnownCurrentTime = state.currentTime;
      }

      // ALWAYS resume IMMEDIATELY - no conditions - ABSOLUTE NO DELAY
      // Ensure currentTime is set before playing - CRITICAL!
      if (state.currentTime && audio.readyState >= 2 && audio.duration > 0) {
        audio.currentTime = state.currentTime;
        lastKnownCurrentTime = state.currentTime;
      }

      // Play immediately - NO conditions, NO checks, NO delays - ULTRA AGGRESSIVE
      for (let i = 0; i < 10; i++) {
        audio.play().catch(() => {});
      }

      // Immediate double-check after microtask - ALWAYS play
      Promise.resolve().then(() => {
        if (audio.paused) {
          audio.play().catch(() => {});
          audio.play().catch(() => {});
        }
      });

      // Also check after next frame - ALWAYS play
      requestAnimationFrame(() => {
        if (audio.paused) {
          audio.play().catch(() => {});
          audio.play().catch(() => {});
        }
      });

      // Continuous monitoring to FORCE audio to ALWAYS play - ULTRA AGGRESSIVE
      const checkAndResume = () => {
        const audio = window.__baocapAudio__;
        if (!audio) return;

        const state = getAudioState();
        // ALWAYS resume if paused - no conditions!
        if (audio.paused) {
          // Restore currentTime if needed
          if (
            state &&
            state.currentTime &&
            audio.readyState >= 2 &&
            audio.duration > 0
          ) {
            if (Math.abs(audio.currentTime - state.currentTime) > 0.5) {
              audio.currentTime = state.currentTime;
              lastKnownCurrentTime = state.currentTime;
            }
          }
          // Resume immediately - ULTRA AGGRESSIVE
          for (let i = 0; i < 5; i++) {
            audio.play().catch(() => {});
          }
        }
      };

      // Check immediately - multiple times to ensure it resumes
      checkAndResume();
      requestAnimationFrame(checkAndResume);
      requestAnimationFrame(() => requestAnimationFrame(checkAndResume));

      // Also set up continuous monitoring for this page - ALWAYS keep playing
      const monitorInterval = setInterval(() => {
        checkAndResume();
      }, 50); // Check every 50ms on page load to ALWAYS ensure playback
    });
  })();

  // Ensure all internal links use View Transitions (no full page reload)
  (function () {
    // Intercept all link clicks to ensure View Transitions are used
    document.addEventListener(
      "click",
      function (e) {
        const target = e.target;
        const link = target.closest ? target.closest("a[href]") : null;

        if (!link) return;

        const href = link.getAttribute("href");
        if (!href) return;

        // Skip external links, mailto, tel, and anchor-only links
        if (
          href.startsWith("http://") ||
          href.startsWith("https://") ||
          href.startsWith("mailto:") ||
          href.startsWith("tel:") ||
          href.startsWith("#")
        ) {
          // For anchor links, use smooth scroll without page reload
          if (href.startsWith("#")) {
            e.preventDefault();
            const targetId = href.substring(1);
            const targetElement =
              document.getElementById(targetId) ||
              document.querySelector('[id="' + targetId + '"]');
            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
              // Update URL without reload
              history.pushState(null, "", href);
            }
          }
          return;
        }

        // For internal links, ensure View Transitions are used (no full reload)
        // Check if link has target="_blank" or other attributes that bypass View Transitions
        if (
          link.hasAttribute("target") &&
          link.getAttribute("target") !== "_self"
        ) {
          return; // Skip links that should open in new window
        }

        // CRITICAL: Ensure audio continues playing during transition
        // Save audio state and prevent pause during navigation
        const audio = window.__baocapAudio__;
        if (audio) {
          const wasPlaying = !audio.paused;
          const currentTime = audio.currentTime;
          const volume = audio.volume;

          // Save state immediately
          const state = {
            isPlaying: wasPlaying,
            volume: volume,
            currentTime: currentTime,
          };
          saveAudioStateToStorage(state);

          // If audio was playing, ensure it continues during navigation
          if (wasPlaying) {
            // Add listener to prevent pause during navigation
            const preventPauseOnNav = () => {
              if (wasPlaying && audio.paused) {
                audio.currentTime = currentTime;
                audio.play().catch(() => {});
              }
            };

            audio.addEventListener("pause", preventPauseOnNav, {
              once: true,
              capture: true,
            });

            // Also monitor continuously during navigation
            const navMonitor = setInterval(() => {
              if (wasPlaying && audio.paused) {
                audio.currentTime = currentTime;
                audio.play().catch(() => {});
              }
            }, 30); // Check every 30ms during navigation

            // Stop monitoring after navigation completes
            document.addEventListener(
              "astro:page-load",
              () => {
                clearInterval(navMonitor);
                audio.removeEventListener("pause", preventPauseOnNav, {
                  capture: true,
                });
              },
              { once: true }
            );
          }
        }

        // Let Astro handle View Transitions - don't prevent default for internal links
      },
      true
    ); // Use capture phase to catch links early
  })();
</script>
