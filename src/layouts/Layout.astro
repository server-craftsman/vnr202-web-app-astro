---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = "Bảo Tàng Thời Bao Cấp",
  description = "Trải nghiệm tương tác về thời kỳ kinh tế bao cấp Việt Nam 1975-1986. Khám phá lịch sử, hiện vật và câu chuyện về giai đoạn 1975-1986",
  image = "/assets/bg2.jpg",
  url = Astro.url.href,
} = Astro.props;

const siteUrl = Astro.site || "https://vnr202-web-app-astro.pages.dev";
const fullImageUrl = image.startsWith("http")
  ? image
  : siteUrl + (image.startsWith("/") ? image : "/" + image);
const fullUrl = url.startsWith("http")
  ? url
  : siteUrl + (url.startsWith("/") ? url : "/" + url);

import "../styles/tailwind.css";
import AudioToggle from "../components/AudioToggle.astro";
import ScrollAnimations from "../components/ScrollAnimations.astro";
import { ViewTransitions } from "astro:transitions";
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:site_name" content="Bảo Tàng Thời Bao Cấp" />
    <meta property="og:locale" content="vi_VN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="theme-color" content="#d4af37" />

    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-gradient-to-b from-neutral-950 via-neutral-900 to-neutral-800 text-white antialiased selection:bg-yellow-300/20 selection:text-yellow-100"
  >
    <slot />
    <AudioToggle />
    <ScrollAnimations />
  </body>
</html>

<script is:inline>
  // Persistent audio across ALL pages - runs immediately
  (function () {
    const AUDIO_KEY = "baocap_audio_state";

    // Check if audio already exists globally
    if (!window.__baocapAudio__) {
      // Create audio element ONCE with persistence
      const audio = document.createElement("audio");
      audio.id = "ambient-audio";
      audio.src = "/music-for-victory-parade.mp3";
      audio.loop = true;
      audio.preload = "auto";
      audio.style.display = "none";
      audio.setAttribute("data-astro-transition-persist", "audio-player");

      // Append to body immediately
      if (document.body) {
        document.body.appendChild(audio);
      } else {
        document.addEventListener("DOMContentLoaded", () => {
          document.body.appendChild(audio);
        });
      }

      // Store globally to survive navigation
      window.__baocapAudio__ = audio;

      // CRITICAL: Override pause method to prevent audio from ever pausing if it should be playing
      const originalPause = audio.pause.bind(audio);
      audio.pause = function () {
        const savedState = localStorage.getItem(AUDIO_KEY);
        if (savedState) {
          try {
            const state = JSON.parse(savedState);
            // If audio should be playing, prevent pause
            if (state.isPlaying) {
              // Don't pause - just return immediately
              return;
            }
          } catch (e) {}
        }
        // Only pause if user explicitly wants to pause (state.isPlaying = false)
        return originalPause();
      };

      // Override load() to ensure it doesn't pause
      const originalLoad = audio.load.bind(audio);
      audio.load = function () {
        const savedState = localStorage.getItem(AUDIO_KEY);
        const wasPlaying = savedState
          ? (() => {
              try {
                const state = JSON.parse(savedState);
                return state.isPlaying;
              } catch (e) {
                return false;
              }
            })()
          : false;

        originalLoad.call(this);

        // If it was playing, resume immediately after load
        if (wasPlaying) {
          setTimeout(() => {
            this.play().catch(() => {});
            this.play().catch(() => {});
          }, 0);
        }
      };

      // AGGRESSIVE: Prevent pause event from EVER firing if audio should be playing
      const preventPauseHandler = (e) => {
        e.preventDefault();
        e.stopImmediatePropagation();

        const savedState = localStorage.getItem(AUDIO_KEY);
        if (savedState) {
          try {
            const state = JSON.parse(savedState);
            if (state.isPlaying) {
              // Resume IMMEDIATELY - NO DELAY AT ALL
              audio.play().catch(() => {});
              audio.play().catch(() => {});
              audio.play().catch(() => {});

              // Also use all async methods to ensure it resumes
              Promise.resolve().then(() => {
                if (audio.paused && state.isPlaying) {
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});
                }
              });

              requestAnimationFrame(() => {
                if (audio.paused && state.isPlaying) {
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});
                }
              });

              if (window.requestIdleCallback) {
                requestIdleCallback(
                  () => {
                    if (audio.paused && state.isPlaying) {
                      audio.play().catch(() => {});
                      audio.play().catch(() => {});
                    }
                  },
                  { timeout: 0 }
                );
              }

              return false;
            }
          } catch (e) {}
        }
      };

      // Add multiple listeners with different phases and priorities
      audio.addEventListener("pause", preventPauseHandler, {
        passive: false,
        capture: true,
        once: false,
      });

      // Also add to the event target phase
      audio.addEventListener("pause", preventPauseHandler, {
        passive: false,
        capture: false,
        once: false,
      });

      // Restore state from localStorage
      const savedState = localStorage.getItem(AUDIO_KEY);
      if (savedState) {
        try {
          const state = JSON.parse(savedState);
          audio.volume = state.volume || 0.7;

          if (state.currentTime && audio.duration > 0) {
            audio.currentTime = state.currentTime;
          }

          // Restore playing state - try to auto-resume if it was playing
          if (state.isPlaying) {
            // Play immediately - no delays, no checks
            const tryResume = () => {
              if (audio && audio.paused) {
                audio.play().catch(() => {
                  // Auto-play blocked, will need user interaction
                });
              }
              // Double-check: ensure it's playing
              if (audio && audio.paused) {
                audio.play().catch(() => {});
              }
            };

            // Try immediately - no conditions
            tryResume();

            // Also try when audio is ready (if not already)
            if (audio.readyState < 2) {
              audio.addEventListener("canplaythrough", tryResume, {
                once: true,
              });
              audio.addEventListener("loadeddata", tryResume, { once: true });
            }
          }
        } catch (e) {
          console.log("Could not restore audio state:", e);
        }
      } else {
        // Default volume
        audio.volume = 0.7;
      }
    }

    // Save state periodically and before unload
    function saveAudioState() {
      const audio = window.__baocapAudio__;
      if (audio) {
        const state = {
          isPlaying: !audio.paused,
          volume: audio.volume,
          currentTime: audio.currentTime,
        };
        localStorage.setItem(AUDIO_KEY, JSON.stringify(state));
      }
    }

    // Save every 5 seconds if playing
    setInterval(() => {
      const audio = window.__baocapAudio__;
      if (audio && !audio.paused) {
        saveAudioState();
      }
    }, 5000);

    // Continuous monitoring to ensure audio keeps playing during page transitions
    setInterval(() => {
      const audio = window.__baocapAudio__;
      if (!audio) return;

      const savedState = localStorage.getItem(AUDIO_KEY);
      if (savedState) {
        try {
          const state = JSON.parse(savedState);
          // If audio should be playing but is paused, resume immediately
          if (state.isPlaying && audio.paused) {
            // Resume immediately - no delay
            audio.play().catch(() => {});
          }
        } catch (e) {}
      }
    }, 100); // Check every 100ms to ensure continuous playback

    // Save before unload
    window.addEventListener("beforeunload", saveAudioState);
    window.addEventListener("pagehide", saveAudioState);

    // Use MutationObserver to detect if audio element is removed/recreated
    if (window.__baocapAudio__) {
      const audio = window.__baocapAudio__;
      const observer = new MutationObserver((mutations) => {
        const savedState = localStorage.getItem(AUDIO_KEY);
        if (savedState) {
          try {
            const state = JSON.parse(savedState);
            if (state.isPlaying && audio.paused) {
              // Resume immediately if audio was paused during mutation
              audio.play().catch(() => {});
              audio.play().catch(() => {});
              audio.play().catch(() => {});
            }
          } catch (e) {}
        }
      });

      observer.observe(document.body || document.documentElement, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ["src", "preload"],
      });
    }

    // Handle View Transitions - prevent audio pause and ensure continuous playback
    document.addEventListener("astro:before-preparation", () => {
      // Save state right before page transition
      const audio = window.__baocapAudio__;
      if (audio) {
        const savedState = localStorage.getItem(AUDIO_KEY);
        if (savedState) {
          try {
            const state = JSON.parse(savedState);
            if (state.isPlaying) {
              // CRITICAL: Ensure audio continues playing DURING transition
              // Don't let it pause at all
              if (audio.paused) {
                // Resume immediately before transition starts
                audio.currentTime = state.currentTime || audio.currentTime;
                audio.play().catch(() => {});
              }

              // Play multiple times BEFORE transition starts to ensure it doesn't pause
              audio.play().catch(() => {});
              audio.play().catch(() => {});
              audio.play().catch(() => {});

              // Add aggressive listener to prevent ANY pause during transition
              const preventPauseDuringTransition = (e) => {
                e.preventDefault();
                e.stopImmediatePropagation();

                if (state.isPlaying && audio.paused) {
                  // Resume immediately - play multiple times, NO DELAY
                  audio.currentTime = state.currentTime || audio.currentTime;
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});

                  // Use all async methods
                  Promise.resolve().then(() => {
                    if (audio.paused && state.isPlaying) {
                      audio.play().catch(() => {});
                      audio.play().catch(() => {});
                    }
                  });

                  requestAnimationFrame(() => {
                    if (audio.paused && state.isPlaying) {
                      audio.play().catch(() => {});
                      audio.play().catch(() => {});
                    }
                  });

                  return false;
                }
              };

              // Listen in capture phase to catch pause events early - MULTIPLE LISTENERS
              audio.addEventListener("pause", preventPauseDuringTransition, {
                passive: false,
                capture: true,
                once: false, // Keep listening during entire transition
              });

              // Also in bubble phase
              audio.addEventListener("pause", preventPauseDuringTransition, {
                passive: false,
                capture: false,
                once: false,
              });

              // Also monitor continuously during transition - VERY AGGRESSIVE
              const monitorInterval = setInterval(() => {
                if (state.isPlaying && audio.paused) {
                  // Play multiple times to ensure it works
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});
                  audio.play().catch(() => {});
                }
              }, 5); // Check every 5ms during transition - MAXIMUM RESPONSIVENESS

              // Stop monitoring after transition completes
              document.addEventListener(
                "astro:page-load",
                () => {
                  clearInterval(monitorInterval);
                  audio.removeEventListener(
                    "pause",
                    preventPauseDuringTransition,
                    { capture: true }
                  );
                  audio.removeEventListener(
                    "pause",
                    preventPauseDuringTransition,
                    { capture: false }
                  );
                },
                { once: true }
              );
            }
          } catch (e) {}
        }

        // Save current state
        saveAudioState();
      }
    });

    // Resume audio IMMEDIATELY when page loads (BEFORE astro:page-load)
    function immediateAudioResume() {
      const audio = window.__baocapAudio__;
      if (!audio) return;

      const savedState = localStorage.getItem(AUDIO_KEY);
      if (savedState) {
        try {
          const state = JSON.parse(savedState);

          // Restore volume immediately
          audio.volume = state.volume || 0.7;

          // CRITICAL: If it was playing, resume IMMEDIATELY - ABSOLUTE NO DELAY
          if (state.isPlaying) {
            // Play immediately - NO conditions, NO checks, NO delays
            // Play multiple times to ensure it works
            audio.play().catch(() => {});
            audio.play().catch(() => {});
            audio.play().catch(() => {});
            audio.play().catch(() => {});
            audio.play().catch(() => {});

            // Also restore current time immediately if valid
            if (
              state.currentTime &&
              audio.duration > 0 &&
              Math.abs(audio.currentTime - state.currentTime) > 0.5
            ) {
              audio.currentTime = state.currentTime;
            }

            // Use ALL async methods to ensure it resumes
            Promise.resolve().then(() => {
              if (audio.paused && state.isPlaying) {
                audio.play().catch(() => {});
                audio.play().catch(() => {});
              }
            });

            setTimeout(() => {
              if (audio.paused && state.isPlaying) {
                audio.play().catch(() => {});
                audio.play().catch(() => {});
              }
            }, 0);

            requestAnimationFrame(() => {
              if (audio.paused && state.isPlaying) {
                audio.play().catch(() => {});
                audio.play().catch(() => {});
              }
            });

            if (window.requestIdleCallback) {
              requestIdleCallback(
                () => {
                  if (audio.paused && state.isPlaying) {
                    audio.play().catch(() => {});
                    audio.play().catch(() => {});
                  }
                },
                { timeout: 0 }
              );
            }
          }
        } catch (e) {}
      }
    }

    // Call IMMEDIATELY in ALL possible ways (before View Transitions)

    // 1. Immediately if DOM already ready
    if (document.readyState !== "loading") {
      immediateAudioResume();
    }

    // 2. On DOMContentLoaded (before any other scripts)
    document.addEventListener("DOMContentLoaded", immediateAudioResume, {
      once: true,
      capture: true,
    });

    // 3. On window load
    window.addEventListener("load", immediateAudioResume, {
      once: true,
      capture: true,
    });

    // 4. Immediately in current execution context
    immediateAudioResume();

    // Also call on astro:page-load for redundancy
    document.addEventListener("astro:page-load", () => {
      const audio = window.__baocapAudio__;
      if (!audio) return;

      // IMMEDIATELY restore audio - ABSOLUTE NO DELAY, NO WAITING
      const savedState = localStorage.getItem(AUDIO_KEY);
      if (savedState) {
        try {
          const state = JSON.parse(savedState);

          // Restore volume immediately
          audio.volume = state.volume || 0.7;

          // Restore current time immediately if valid
          if (
            state.currentTime &&
            audio.duration > 0 &&
            Math.abs(audio.currentTime - state.currentTime) > 0.5
          ) {
            audio.currentTime = state.currentTime;
          }

          // CRITICAL: If it was playing, resume IMMEDIATELY - ABSOLUTE NO DELAY
          if (state.isPlaying) {
            // Play immediately - NO conditions, NO checks, NO delays
            audio.play().catch(() => {});
            audio.play().catch(() => {});
            audio.play().catch(() => {});

            // Immediate double-check after microtask
            Promise.resolve().then(() => {
              if (audio.paused && state.isPlaying) {
                audio.play().catch(() => {});
                audio.play().catch(() => {});
              }
            });

            // Also check after next frame
            requestAnimationFrame(() => {
              if (audio.paused && state.isPlaying) {
                audio.play().catch(() => {});
                audio.play().catch(() => {});
              }
            });
          }
        } catch (e) {
          console.log("Could not restore audio on page load:", e);
        }
      }

      // Continuous monitoring to ensure audio keeps playing
      const checkAndResume = () => {
        const audio = window.__baocapAudio__;
        if (!audio) return;

        const savedState = localStorage.getItem(AUDIO_KEY);
        if (savedState) {
          try {
            const state = JSON.parse(savedState);
            // If audio should be playing but is paused, resume immediately
            if (state.isPlaying && audio.paused) {
              // Resume immediately - no delay
              audio.play().catch(() => {});
            }
          } catch (e) {}
        }
      };

      // Check immediately - multiple times to ensure it resumes
      checkAndResume();
      requestAnimationFrame(checkAndResume);
      requestAnimationFrame(() => requestAnimationFrame(checkAndResume));

      // Also set up continuous monitoring for this page
      const monitorInterval = setInterval(() => {
        checkAndResume();
        // Stop monitoring if audio is not supposed to be playing
        const savedState = localStorage.getItem(AUDIO_KEY);
        if (savedState) {
          try {
            const state = JSON.parse(savedState);
            if (!state.isPlaying) {
              clearInterval(monitorInterval);
            }
          } catch (e) {
            clearInterval(monitorInterval);
          }
        } else {
          clearInterval(monitorInterval);
        }
      }, 50); // Check every 50ms on page load to catch any immediate pauses
    });
  })();

  // Ensure all internal links use View Transitions (no full page reload)
  (function () {
    // Intercept all link clicks to ensure View Transitions are used
    document.addEventListener(
      "click",
      function (e) {
        const target = e.target;
        const link = target.closest ? target.closest("a[href]") : null;

        if (!link) return;

        const href = link.getAttribute("href");
        if (!href) return;

        // Skip external links, mailto, tel, and anchor-only links
        if (
          href.startsWith("http://") ||
          href.startsWith("https://") ||
          href.startsWith("mailto:") ||
          href.startsWith("tel:") ||
          href.startsWith("#")
        ) {
          // For anchor links, use smooth scroll without page reload
          if (href.startsWith("#")) {
            e.preventDefault();
            const targetId = href.substring(1);
            const targetElement =
              document.getElementById(targetId) ||
              document.querySelector('[id="' + targetId + '"]');
            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
              // Update URL without reload
              history.pushState(null, "", href);
            }
          }
          return;
        }

        // For internal links, ensure View Transitions are used (no full reload)
        // Check if link has target="_blank" or other attributes that bypass View Transitions
        if (
          link.hasAttribute("target") &&
          link.getAttribute("target") !== "_self"
        ) {
          return; // Skip links that should open in new window
        }

        // CRITICAL: Ensure audio continues playing during transition
        // Save audio state and prevent pause during navigation
        const audio = window.__baocapAudio__;
        if (audio) {
          const wasPlaying = !audio.paused;
          const currentTime = audio.currentTime;
          const volume = audio.volume;

          // Save state immediately
          const state = {
            isPlaying: wasPlaying,
            volume: volume,
            currentTime: currentTime,
          };
          localStorage.setItem("baocap_audio_state", JSON.stringify(state));

          // If audio was playing, ensure it continues during navigation
          if (wasPlaying) {
            // Add listener to prevent pause during navigation
            const preventPauseOnNav = () => {
              if (wasPlaying && audio.paused) {
                audio.currentTime = currentTime;
                audio.play().catch(() => {});
              }
            };

            audio.addEventListener("pause", preventPauseOnNav, {
              once: true,
              capture: true,
            });

            // Also monitor continuously during navigation
            const navMonitor = setInterval(() => {
              if (wasPlaying && audio.paused) {
                audio.currentTime = currentTime;
                audio.play().catch(() => {});
              }
            }, 30); // Check every 30ms during navigation

            // Stop monitoring after navigation completes
            document.addEventListener(
              "astro:page-load",
              () => {
                clearInterval(navMonitor);
                audio.removeEventListener("pause", preventPauseOnNav, {
                  capture: true,
                });
              },
              { once: true }
            );
          }
        }

        // Let Astro handle View Transitions - don't prevent default for internal links
      },
      true
    ); // Use capture phase to catch links early
  })();
</script>
