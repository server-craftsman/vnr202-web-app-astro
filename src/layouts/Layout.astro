---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = "Bảo Tàng Thời Bao Cấp",
  description = "Trải nghiệm tương tác về thời kỳ kinh tế bao cấp Việt Nam 1975-1986. Khám phá lịch sử, hiện vật và câu chuyện về giai đoạn 1975-1986",
  image = "/assets/bg2.jpg",
  url = Astro.url.href,
} = Astro.props;

const siteUrl = Astro.site || "https://vnr202-web-app-astro.pages.dev";
const fullImageUrl = image.startsWith("http")
  ? image
  : siteUrl + (image.startsWith("/") ? image : "/" + image);
const fullUrl = url.startsWith("http")
  ? url
  : siteUrl + (url.startsWith("/") ? url : "/" + url);

import "../styles/tailwind.css";
import AudioToggle from "../components/AudioToggle.astro";
import ScrollAnimations from "../components/ScrollAnimations.astro";
import { ViewTransitions } from "astro:transitions";
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:site_name" content="Bảo Tàng Thời Bao Cấp" />
    <meta property="og:locale" content="vi_VN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="theme-color" content="#d4af37" />

    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-gradient-to-b from-neutral-950 via-neutral-900 to-neutral-800 text-white antialiased selection:bg-yellow-300/20 selection:text-yellow-100"
  >
    <slot />
    <AudioToggle />
    <ScrollAnimations />
  </body>
</html>

<script is:inline>
  // Persistent audio across ALL pages - runs immediately
  (function () {
    const AUDIO_KEY = "baocap_audio_state";

    // Check if audio already exists globally
    if (!window.__baocapAudio__) {
      // Create audio element ONCE with persistence
      const audio = document.createElement("audio");
      audio.id = "ambient-audio";
      audio.src = "/MUSIC_FOR_VICTORY_PARADE_МУЗЫКА_ПАРАДА_ПОБЕДЫ.mp3";
      audio.loop = true;
      audio.style.display = "none";
      audio.setAttribute("data-astro-transition-persist", "audio-player");

      // Append to body immediately
      if (document.body) {
        document.body.appendChild(audio);
      } else {
        document.addEventListener("DOMContentLoaded", () => {
          document.body.appendChild(audio);
        });
      }

      // Store globally to survive navigation
      window.__baocapAudio__ = audio;

      // Restore state from localStorage
      const savedState = localStorage.getItem(AUDIO_KEY);
      if (savedState) {
        try {
          const state = JSON.parse(savedState);
          audio.volume = state.volume || 0.7;

          if (state.currentTime) {
            audio.currentTime = state.currentTime;
          }

          // Check if audio was previously activated (permanent)
          const activated =
            localStorage.getItem("baocap_audio_activated") === "true";

          if (state.isPlaying || activated) {
            // Try to auto-play (especially if previously activated)
            audio.play().catch(() => {
              // Auto-play might be blocked, but will resume when user interacts
              if (activated) {
                // For activated audio, ensure it plays as soon as possible
                const tryPlay = () => {
                  audio.play().catch(() => {});
                  // Remove listener after first try
                  document.removeEventListener("click", tryPlay);
                  document.removeEventListener("touchstart", tryPlay);
                };
                document.addEventListener("click", tryPlay, { once: true });
                document.addEventListener("touchstart", tryPlay, {
                  once: true,
                });
              } else {
                console.log("Auto-play blocked. Click audio button to play.");
              }
            });

            // If activated, ensure it stays playing
            if (activated) {
              // Listen for pause events and resume immediately
              audio.addEventListener(
                "pause",
                () => {
                  if (audio.paused) {
                    audio.play().catch(() => {});
                  }
                },
                { passive: true }
              );

              // Periodic check to ensure it's playing
              setInterval(() => {
                if (audio.paused && activated) {
                  audio.play().catch(() => {});
                }
              }, 1000);
            }
          }
        } catch (e) {
          console.log("Could not restore audio state:", e);
        }
      } else {
        // Default volume
        audio.volume = 0.7;
      }
    }

    // Save state periodically and before unload
    function saveAudioState() {
      const audio = window.__baocapAudio__;
      if (audio) {
        const activated =
          localStorage.getItem("baocap_audio_activated") === "true";
        const state = {
          isPlaying: !audio.paused || activated, // Always save as playing if activated
          volume: audio.volume,
          currentTime: audio.currentTime,
        };
        localStorage.setItem(AUDIO_KEY, JSON.stringify(state));
      }
    }

    // Save every 5 seconds if playing or activated
    setInterval(() => {
      const audio = window.__baocapAudio__;
      const activated =
        localStorage.getItem("baocap_audio_activated") === "true";
      if (audio && (!audio.paused || activated)) {
        saveAudioState();

        // If activated but paused, resume
        if (activated && audio.paused) {
          audio.play().catch(() => {});
        }
      }
    }, 5000);

    // Additional safety: Monitor for pause events if activated
    if (window.__baocapAudio__) {
      const audio = window.__baocapAudio__;
      const activated =
        localStorage.getItem("baocap_audio_activated") === "true";

      if (activated) {
        // Prevent pause if activated
        audio.addEventListener(
          "pause",
          (e) => {
            if (activated) {
              // Resume immediately
              setTimeout(() => {
                if (audio.paused) {
                  audio.play().catch(() => {});
                }
              }, 50);
            }
          },
          { passive: true }
        );
      }
    }

    // Save before unload
    window.addEventListener("beforeunload", saveAudioState);
    window.addEventListener("pagehide", saveAudioState);
  })();
</script>
