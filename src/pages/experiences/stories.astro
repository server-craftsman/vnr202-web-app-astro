---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icons.astro';
import { stories } from '../../data/stories';
---

<Layout title="Kể chuyện Lịch sử | Trải nghiệm Bao Cấp">
  <main class="min-h-screen bg-gradient-to-b from-stone-950 via-neutral-900 to-stone-900 py-16 px-6">
    <div class="max-w-7xl mx-auto">
      <!-- Back Button -->
      <a href="/#experience" class="inline-flex items-center gap-2 text-amber-400 hover:text-amber-300 font-semibold mb-12 transition-colors group">
        <Icon name="arrow-left" class="w-5 h-5 group-hover:-translate-x-1 transition-transform" />
        Trở về Trải nghiệm
      </a>

      <!-- Header -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-amber-500 to-yellow-600 rounded-3xl mb-6 shadow-2xl">
          <Icon name="book" class="w-10 h-10 text-stone-950" />
        </div>
        <h1 class="font-['Playfair_Display'] text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-amber-300 to-yellow-500 bg-clip-text text-transparent">
          Kể chuyện Lịch sử
        </h1>
        <p class="text-xl md:text-2xl text-neutral-300 max-w-3xl mx-auto">
          Những câu chuyện chân thực từ người dân đã sống qua thời bao cấp
        </p>
      </div>

      <!-- Filter by Category -->
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        <button class="category-filter active px-6 py-3 rounded-full bg-gradient-to-r from-amber-500 to-yellow-600 text-stone-950 font-semibold shadow-xl transition-all flex items-center gap-2" data-category="all">
          <Icon name="collection" class="w-5 h-5" />
          Tất cả
        </button>
        <button class="category-filter px-6 py-3 rounded-full border-2 border-amber-500/30 text-amber-300 font-semibold hover:bg-amber-500/10 transition-all flex items-center gap-2" data-category="family">
          <Icon name="home" class="w-5 h-5" />
          Gia đình
        </button>
        <button class="category-filter px-6 py-3 rounded-full border-2 border-amber-500/30 text-amber-300 font-semibold hover:bg-amber-500/10 transition-all flex items-center gap-2" data-category="work">
          <Icon name="briefcase" class="w-5 h-5" />
          Công việc
        </button>
        <button class="category-filter px-6 py-3 rounded-full border-2 border-amber-500/30 text-amber-300 font-semibold hover:bg-amber-500/10 transition-all flex items-center gap-2" data-category="daily">
          <Icon name="clock" class="w-5 h-5" />
          Đời sống
        </button>
        <button class="category-filter px-6 py-3 rounded-full border-2 border-amber-500/30 text-amber-300 font-semibold hover:bg-amber-500/10 transition-all flex items-center gap-2" data-category="culture">
          <Icon name="sparkles" class="w-5 h-5" />
          Văn hóa
        </button>
      </div>

      <!-- Stories Grid -->
      <div class="grid md:grid-cols-2 gap-8 mb-16">
        {stories.map((story) => (
          <div class="story-card group bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/20 rounded-3xl overflow-hidden hover:border-amber-500/50 hover:-translate-y-2 hover:shadow-2xl hover:shadow-amber-500/20 transition-all duration-500" data-category={story.category}>
            <!-- Story Image -->
            {story.image && (
              <div class="relative h-64 overflow-hidden">
                <img 
                  src={story.image} 
                  alt={story.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-stone-900 to-transparent"></div>
                <!-- Year Badge -->
                <div class="absolute top-4 right-4 px-4 py-2 bg-black/80 backdrop-blur-sm rounded-full border border-amber-500/30 flex items-center gap-2">
                  <Icon name="calendar" class="w-4 h-4 text-amber-400" />
                  <span class="text-amber-400 font-bold">{story.year}</span>
                </div>
              </div>
            )}

            <!-- Content -->
            <div class="p-8">
              <!-- Category Badge -->
              <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-amber-500/15 border border-amber-500/30 rounded-full text-amber-300 text-sm font-medium mb-4">
                <Icon name={story.category === 'family' ? 'home' : story.category === 'work' ? 'briefcase' : story.category === 'culture' ? 'sparkles' : 'clock'} class="w-4 h-4" />
                {story.category === 'family' ? 'Gia đình' : story.category === 'work' ? 'Công việc' : story.category === 'culture' ? 'Văn hóa' : 'Đời sống'}
              </div>

              <!-- Title -->
              <h2 class="font-['Playfair_Display'] text-2xl font-bold mb-3 text-white group-hover:text-amber-300 transition-colors">
                {story.title}
              </h2>

              <!-- Author -->
              <div class="flex items-center gap-2 text-neutral-400 text-sm mb-4">
                <Icon name="users" class="w-4 h-4" />
                <span>{story.author}</span>
              </div>

              <!-- Excerpt -->
              <p class="text-neutral-300 leading-relaxed mb-6 line-clamp-3">
                {story.excerpt}
              </p>

              <!-- Keywords -->
              <div class="flex flex-wrap gap-2 mb-6">
                {story.keywords.map(keyword => (
                  <span class="px-3 py-1 bg-amber-500/10 border border-amber-500/20 rounded-full text-xs text-amber-300">
                    {keyword}
                  </span>
                ))}
              </div>

              <!-- Read More Button -->
              <button class="read-more-btn flex items-center gap-2 text-amber-400 hover:text-amber-300 font-semibold transition-colors group/btn" data-story-id={story.id}>
                <span>Đọc câu chuyện đầy đủ</span>
                <Icon name="arrow-right" class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" />
              </button>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- Story Modal -->
    <div id="story-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-6 bg-black/90 backdrop-blur-sm">
      <div class="relative bg-gradient-to-br from-stone-800/95 to-stone-900/95 backdrop-blur-xl border border-amber-500/30 rounded-3xl max-w-4xl w-full max-h-[90vh] overflow-y-auto shadow-2xl">
        <!-- Close Button -->
        <button id="close-modal" class="absolute top-6 right-6 w-10 h-10 bg-stone-900/50 hover:bg-stone-800 border border-amber-500/30 rounded-full flex items-center justify-center transition-colors z-10">
          <Icon name="x" class="w-5 h-5 text-amber-300" />
        </button>

        <!-- Modal Content -->
        <div id="modal-content" class="p-12">
          <!-- Will be filled by JavaScript -->
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ stories }}>
  const categoryFilters = document.querySelectorAll('.category-filter');
  const storyCards = document.querySelectorAll('.story-card');
  const modal = document.getElementById('story-modal');
  const modalContent = document.getElementById('modal-content');
  const closeModal = document.getElementById('close-modal');

  // Category filter
  categoryFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.dataset.category;
      
      // Update active state
      categoryFilters.forEach(b => {
        b.classList.remove('active', 'bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-stone-950');
        b.classList.add('border-2', 'border-amber-500/30', 'text-amber-300');
      });
      btn.classList.add('active', 'bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-stone-950');
      btn.classList.remove('border-2', 'border-amber-500/30', 'text-amber-300');

      // Filter stories
      storyCards.forEach(card => {
        const cardEl = card;
        if (category === 'all' || cardEl.dataset.category === category) {
          cardEl.style.display = 'block';
        } else {
          cardEl.style.display = 'none';
        }
      });
    });
  });

  // Read more
  document.querySelectorAll('.read-more-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const storyId = btn.dataset.storyId;
      const story = stories.find(s => s.id === storyId);
      
      if (story && modalContent) {
        modalContent.innerHTML = `
          ${story.image ? `<img src="${story.image}" alt="${story.title}" class="w-full h-80 object-cover rounded-2xl mb-8" />` : ''}
          <div class="flex items-center gap-3 mb-4">
            <span class="px-4 py-2 bg-amber-500/15 border border-amber-500/30 rounded-full text-amber-300 text-sm font-medium capitalize">${story.category}</span>
            <span class="px-4 py-2 bg-amber-500/15 border border-amber-500/30 rounded-full text-amber-300 text-sm font-medium">${story.year}</span>
          </div>
          <h2 class="font-['Playfair_Display'] text-4xl font-bold mb-4 text-amber-300">${story.title}</h2>
          <div class="flex items-center gap-2 text-neutral-400 mb-8">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <span class="italic">${story.author}</span>
          </div>
          <div class="prose prose-invert prose-lg max-w-none">
            <p class="text-neutral-200 leading-relaxed text-lg whitespace-pre-line">${story.content}</p>
          </div>
          <div class="flex flex-wrap gap-2 mt-8">
            ${story.keywords.map(k => `<span class="px-3 py-1 bg-amber-500/15 border border-amber-500/30 rounded-full text-sm text-amber-300">${k}</span>`).join('')}
          </div>
        `;
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
      }
    });
  });

  // Close modal
  closeModal?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });
</script>

