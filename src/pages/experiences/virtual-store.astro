---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icons.astro";
import SuccessPopup from "../../components/SuccessPopup.astro";

const storeItems = [
  {
    name: "Gạo",
    price: "0.15đ/kg",
    stock: "Còn 45kg",
    tem: "Tem Phiếu Gạo",
    icon: "🍚",
    available: true,
  },
  {
    name: "Thịt lợn",
    price: "2.5đ/kg",
    stock: "Hết hàng",
    tem: "Tem Phiếu Thịt",
    icon: "🥩",
    available: false,
  },
  {
    name: "Đường",
    price: "1.2đ/kg",
    stock: "Còn 12kg",
    tem: "Tem Phiếu Đường",
    icon: "🍬",
    available: true,
  },
  {
    name: "Dầu ăn",
    price: "3.0đ/lít",
    stock: "Còn 8 lít",
    tem: "Tem Phiếu Dầu",
    icon: "🫗",
    available: true,
  },
  {
    name: "Vải",
    price: "5.0đ/m",
    stock: "Hết hàng",
    tem: "Tem Phiếu Vải",
    icon: "👕",
    available: false,
  },
  {
    name: "Xà phòng",
    price: "0.8đ/bánh",
    stock: "Còn 20 bánh",
    tem: "Tem Phiếu XP",
    icon: "🧼",
    available: true,
  },
  {
    name: "Mì",
    price: "0.3đ/gói",
    stock: "Còn 100 gói",
    tem: "Tem Phiếu Mì",
    icon: "🍜",
    available: true,
  },
  {
    name: "Bánh mì",
    price: "0.1đ/ổ",
    stock: "Hết hàng",
    tem: "Tem Phiếu Bánh",
    icon: "🥖",
    available: false,
  },
];
---

<Layout title="Cửa hàng Mậu dịch Ảo | Trải nghiệm Bao Cấp">
  <main
    class="min-h-screen bg-gradient-to-b from-stone-950 via-neutral-900 to-stone-900 py-16 px-6"
  >
    <div class="max-w-7xl mx-auto">
      <!-- Back -->
      <a
        href="/#experience"
        class="inline-flex items-center gap-2 text-amber-400 hover:text-amber-300 font-semibold mb-12 transition-colors group"
      >
        <Icon
          name="arrow-left"
          class="w-5 h-5 group-hover:-translate-x-1 transition-transform"
        />
        Trở về Trải nghiệm
      </a>

      <!-- Store Header -->
      <div class="text-center mb-12">
        <div
          class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-amber-500 to-yellow-600 rounded-3xl mb-6 shadow-2xl"
        >
          <Icon name="shopping-cart" class="w-10 h-10 text-stone-950" />
        </div>
        <h1
          class="font-['Playfair_Display'] text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-amber-300 to-yellow-500 bg-clip-text text-transparent"
        >
          Cửa hàng Mậu dịch Nhà nước
        </h1>
        <p class="text-xl text-neutral-300 max-w-3xl mx-auto mb-6">
          Trải nghiệm mua sắm thời bao cấp - Cần tem phiếu mới mua được hàng!
        </p>

        <!-- Stats Bar -->
        <div class="flex items-center justify-center gap-4 mb-8 flex-wrap">
          <div
            class="px-6 py-3 bg-red-500/20 border border-red-500/40 rounded-2xl text-red-300 font-semibold transition-all duration-300"
            id="queue-container"
          >
            <div class="flex items-center gap-2">
              <Icon name="users" class="w-5 h-5" />
              <span
                >Hàng chờ: <span id="queue-count" class="font-bold text-xl"
                  >47</span
                ></span
              >
            </div>
          </div>
          <div
            class="px-6 py-3 bg-green-500/20 border border-green-500/40 rounded-2xl text-green-300 font-semibold transition-all duration-300"
            id="purchases-container"
          >
            <div class="flex items-center gap-2">
              <Icon name="star" class="w-5 h-5" />
              <span
                >Đã mua: <span id="total-purchases" class="font-bold text-xl"
                  >0</span
                ></span
              >
            </div>
          </div>
          <div
            class="px-6 py-3 bg-blue-500/20 border border-blue-500/40 rounded-2xl text-blue-300 font-semibold transition-all duration-300"
          >
            <div class="flex items-center gap-2">
              <Icon name="chart-bar" class="w-5 h-5" />
              <span
                >Tổng tiền: <span id="total-spent" class="font-bold text-xl"
                  >0đ</span
                ></span
              >
            </div>
          </div>
        </div>

        <!-- Power-ups Bar -->
        <div class="flex items-center justify-center gap-4 mb-6 flex-wrap" id="powerups-bar">
          <button
            id="powerup-bonus-tem"
            class="px-4 py-2 bg-gradient-to-r from-indigo-500/20 to-purple-500/20 border border-indigo-500/40 rounded-xl text-indigo-300 font-semibold hover:scale-110 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
            title="Nhận bonus tem phiếu (Còn: 2)"
          >
            <div class="flex items-center gap-2">
              <Icon name="document" class="w-4 h-4" />
              <span>Bonus Tem</span>
              <span id="bonus-tem-count" class="text-xs bg-indigo-500/30 px-2 py-0.5 rounded-full">2</span>
            </div>
          </button>
          <button
            id="powerup-discount"
            class="px-4 py-2 bg-gradient-to-r from-yellow-500/20 to-orange-500/20 border border-yellow-500/40 rounded-xl text-yellow-300 font-semibold hover:scale-110 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
            title="Giảm giá 20% cho lần mua tiếp theo (Còn: 1)"
          >
            <div class="flex items-center gap-2">
              <Icon name="sparkles" class="w-4 h-4" />
              <span>Giảm giá</span>
              <span id="discount-count" class="text-xs bg-yellow-500/30 px-2 py-0.5 rounded-full">1</span>
            </div>
          </button>
        </div>

        <!-- Notification Area -->
        <div id="notification-area" class="fixed top-4 right-4 z-50 space-y-2 max-w-sm"></div>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Left: Store Items -->
        <div class="lg:col-span-2">
          <div
            class="bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/30 rounded-3xl p-8 shadow-2xl"
          >
            <div class="flex items-center justify-between mb-8">
              <h2
                class="font-['Playfair_Display'] text-2xl font-bold text-amber-300 flex items-center gap-3"
              >
                <Icon name="collection" class="w-6 h-6" />
                Hàng hóa trong kho
              </h2>
              <div class="flex items-center gap-2 text-sm text-neutral-400">
                <Icon name="clock" class="w-4 h-4" />
                <span>Cập nhật: Hôm nay</span>
              </div>
            </div>

            <!-- Items Grid -->
            <div class="grid sm:grid-cols-2 gap-4">
              {
                storeItems.map((item) => (
                  <div
                    class={`relative p-6 rounded-2xl border-2 transition-all ${item.available ? "bg-stone-900/50 border-amber-500/20 hover:border-amber-500/50 hover:bg-stone-800/50" : "bg-stone-900/30 border-neutral-800 opacity-60"}`}
                  >
                    {!item.available && (
                      <div class="absolute top-3 right-3 px-3 py-1 bg-red-500/80 rounded-full text-white text-xs font-bold">
                        HẾT
                      </div>
                    )}
                    <div class="text-5xl mb-3">{item.icon}</div>
                    <h3 class="font-bold text-white mb-2 text-lg">
                      {item.name}
                    </h3>
                    <div class="space-y-1 text-sm mb-4">
                      <div class="flex items-center justify-between text-neutral-300">
                        <span>Giá:</span>
                        <span class="text-amber-400 font-bold">
                          {item.price}
                        </span>
                      </div>
                      <div class="flex items-center justify-between">
                        <span
                          class={
                            item.available ? "text-green-400" : "text-red-400"
                          }
                        >
                          {item.stock}
                        </span>
                      </div>
                    </div>
                    <div class="px-3 py-1.5 bg-amber-500/10 border border-amber-500/30 rounded-lg text-xs text-amber-300 text-center">
                      📄 Cần: {item.tem}
                    </div>
                    {item.available && (
                      <button
                        class="mt-4 w-full px-4 py-2 bg-gradient-to-r from-amber-500 to-yellow-600 rounded-lg text-stone-950 font-semibold hover:scale-105 transition-transform add-to-cart"
                        data-item={item.name}
                      >
                        Thêm vào giỏ
                      </button>
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Right: Shopping Cart -->
        <div class="lg:col-span-1">
          <div
            class="sticky top-24 bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/30 rounded-3xl p-8 shadow-2xl"
          >
            <div class="flex items-center gap-3 mb-6">
              <Icon name="shopping-cart" class="w-6 h-6 text-amber-400" />
              <h3
                class="font-['Playfair_Display'] text-2xl font-bold text-amber-300"
              >
                Giỏ hàng
              </h3>
            </div>

            <div id="cart-items" class="space-y-3 mb-6 min-h-[200px]">
              <div class="text-center text-neutral-500 py-12">
                <Icon
                  name="shopping-cart"
                  class="w-12 h-12 mx-auto mb-3 opacity-30"
                />
                <p>Giỏ hàng trống</p>
              </div>
            </div>

            <div class="border-t border-amber-500/20 pt-4 mb-6">
              <div class="flex justify-between text-lg mb-2">
                <span class="text-neutral-300">Tổng tiền:</span>
                <span class="text-amber-400 font-bold" id="total-price"
                  >0.00đ</span
                >
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-neutral-400">Số món:</span>
                <span class="text-neutral-300" id="item-count">0</span>
              </div>
            </div>

            <button
              id="checkout-btn"
              class="w-full px-6 py-4 bg-gradient-to-r from-green-500 to-emerald-600 rounded-xl text-white font-bold shadow-xl hover:scale-105 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
              disabled
            >
              <Icon name="check" class="w-5 h-5" />
              Thanh toán
            </button>

            <!-- Tem Phieu Status -->
            <div
              class="mt-6 p-4 bg-amber-900/20 border border-amber-500/20 rounded-xl"
            >
              <div class="flex items-center gap-2 mb-2">
                <Icon name="document" class="w-4 h-4 text-amber-400" />
                <span class="text-sm font-semibold text-amber-300"
                  >Tem phiếu còn lại:</span
                >
              </div>
              <div class="text-xs text-neutral-400 space-y-1" id="tem-status">
                <!-- Will be filled by JS -->
              </div>
            </div>

            <!-- Achievements Display -->
            <div class="mt-6 p-4 bg-purple-900/20 border border-purple-500/20 rounded-xl" id="achievements-preview">
              <div class="flex items-center gap-2 mb-2">
                <Icon name="sparkles" class="w-4 h-4 text-purple-400" />
                <span class="text-sm font-semibold text-purple-300"
                  >Thành tích:</span
                >
              </div>
              <div class="flex flex-wrap gap-2" id="achievements-list">
                <!-- Will be filled by JS -->
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Historical Context -->
      <div
        class="mt-16 bg-gradient-to-br from-amber-900/20 to-yellow-900/10 backdrop-blur-xl border border-amber-500/20 rounded-3xl p-10"
      >
        <div class="flex items-center gap-3 mb-6">
          <Icon name="information" class="w-8 h-8 text-amber-400" />
          <h3
            class="font-['Playfair_Display'] text-2xl font-bold text-amber-300"
          >
            Về cửa hàng mậu dịch
          </h3>
        </div>
        <div class="grid md:grid-cols-3 gap-6 text-neutral-200">
          <div
            class="bg-stone-900/30 border border-amber-500/10 rounded-xl p-6"
          >
            <h4 class="font-bold text-amber-300 mb-3">Giờ mở cửa</h4>
            <p class="text-sm leading-relaxed">
              Thường 6h-11h sáng và 14h-17h chiều. Đến muộn có thể hết hàng.
            </p>
          </div>
          <div
            class="bg-stone-900/30 border border-amber-500/10 rounded-xl p-6"
          >
            <h4 class="font-bold text-amber-300 mb-3">Hàng hóa</h4>
            <p class="text-sm leading-relaxed">
              Chủ yếu là thực phẩm thiết yếu. Hàng công nghiệp rất khan hiếm.
            </p>
          </div>
          <div
            class="bg-stone-900/30 border border-amber-500/10 rounded-xl p-6"
          >
            <h4 class="font-bold text-amber-300 mb-3">Quy định</h4>
            <p class="text-sm leading-relaxed">
              Bắt buộc phải có tem phiếu. Không được mua vượt định mức.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SuccessPopup />
</Layout>

<style>
  @keyframes slideInRight {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .notification-enter {
    animation: slideInRight 0.3s ease-out;
  }

  @keyframes pulse-scale {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  .animate-pulse-scale {
    animation: pulse-scale 1s ease-in-out infinite;
  }

  .powerup-active {
    animation: pulse-scale 0.5s ease-in-out infinite;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.6);
  }

  .discount-active {
    border-color: #fbbf24 !important;
    background: rgba(251, 191, 36, 0.2) !important;
    animation: pulse-scale 0.5s ease-in-out infinite;
  }
</style>

<script>
  let cart: Array<{ name: string; price: string; tem: string }> = [];
  let temPhieu: Record<string, number> = {
    "Tem Phiếu Gạo": 1,
    "Tem Phiếu Đường": 1,
    "Tem Phiếu Dầu": 1,
    "Tem Phiếu Mì": 1,
    "Tem Phiếu XP": 1,
  };
  let totalPurchases = 0;
  let totalSpent = 0;
  let queueCount = 47;
  let bonusTemRemaining = 2;
  let discountRemaining = 1;
  let isDiscountActive = false;
  let achievements: string[] = [];

  const itemTemMap: Record<string, string> = {
    "Gạo": "Tem Phiếu Gạo",
    "Thịt lợn": "Tem Phiếu Thịt",
    "Đường": "Tem Phiếu Đường",
    "Dầu ăn": "Tem Phiếu Dầu",
    "Vải": "Tem Phiếu Vải",
    "Xà phòng": "Tem Phiếu XP",
    "Mì": "Tem Phiếu Mì",
    "Bánh mì": "Tem Phiếu Bánh",
  };

  function showNotification(message: string, type: "success" | "error" | "info" | "warning" = "info", duration: number = 3000) {
    const notificationArea = document.getElementById("notification-area");
    if (!notificationArea) return;

    const notification = document.createElement("div");
    const bgColors = {
      success: "from-green-500/20 to-emerald-500/20 border-green-500/40 text-green-300",
      error: "from-red-500/20 to-orange-500/20 border-red-500/40 text-red-300",
      info: "from-blue-500/20 to-indigo-500/20 border-blue-500/40 text-blue-300",
      warning: "from-yellow-500/20 to-amber-500/20 border-yellow-500/40 text-yellow-300"
    };

    notification.className = `notification-enter px-6 py-4 bg-gradient-to-r ${bgColors[type]} border rounded-2xl shadow-2xl backdrop-blur-xl font-semibold`;
    notification.textContent = message;
    notificationArea.appendChild(notification);

    setTimeout(() => {
      notification.style.transition = "all 0.3s ease-out";
      notification.style.transform = "translateX(100%)";
      notification.style.opacity = "0";
      setTimeout(() => notification.remove(), 300);
    }, duration);
  }

  function checkAndAddAchievement(id: string, icon: string, text: string) {
    if (achievements.includes(id)) return;
    
    achievements.push(id);
    updateAchievements();
    showNotification(`🏆 ${icon} ${text}`, "warning", 4000);
  }

  function updateAchievements() {
    const achievementsList = document.getElementById("achievements-list");
    if (!achievementsList) return;

    achievementsList.innerHTML = achievements
      .map(ach => {
        const achievementData: Record<string, { icon: string; text: string }> = {
          "first_purchase": { icon: "🛒", text: "Mua hàng đầu tiên" },
          "big_spender": { icon: "💰", text: "Tiêu nhiều tiền" },
          "smart_shopper": { icon: "🧠", text: "Mua sắm thông minh" },
          "queue_master": { icon: "⚡", text: "Vượt qua hàng chờ" },
          "tem_collector": { icon: "📄", text: "Thu thập tem" },
          "bulk_buyer": { icon: "📦", text: "Mua số lượng lớn" },
          "discount_user": { icon: "🎯", text: "Dùng giảm giá" },
        };
        
        const data = achievementData[ach];
        if (!data) return "";
        
        return `<span class="px-3 py-1 bg-purple-500/20 border border-purple-500/40 rounded-full text-xs text-purple-300 font-semibold">${data.icon} ${data.text}</span>`;
      })
      .filter(Boolean)
      .join("");
  }

  function updateTemStatus() {
    const temStatusEl = document.getElementById("tem-status");
    if (!temStatusEl) return;

    temStatusEl.innerHTML = Object.entries(temPhieu)
      .map(([tem, count]) => {
        const hasTem = count > 0;
        return `<div class="${hasTem ? "text-green-400" : "text-red-400"}">• ${tem.replace("Tem Phiếu ", "")}: ${hasTem ? "✓" : "✗"} ${count > 1 ? `(${count})` : ""}</div>`;
      })
      .join("");
  }

  function updateStats() {
    const totalPurchasesEl = document.getElementById("total-purchases");
    const totalSpentEl = document.getElementById("total-spent");
    const queueEl = document.getElementById("queue-count");
    const bonusTemCountEl = document.getElementById("bonus-tem-count");
    const discountCountEl = document.getElementById("discount-count");

    if (totalPurchasesEl) {
      totalPurchasesEl.textContent = totalPurchases.toString();
      totalPurchasesEl.parentElement?.parentElement?.classList.add("scale-110");
      setTimeout(() => {
        totalPurchasesEl.parentElement?.parentElement?.classList.remove("scale-110");
      }, 300);
    }
    if (totalSpentEl) totalSpentEl.textContent = totalSpent.toFixed(2) + "đ";
    if (queueEl) {
      queueEl.textContent = queueCount.toString();
      const queueContainer = document.getElementById("queue-container");
      if (queueCount <= 10) {
        queueContainer?.classList.add("animate-pulse", "border-green-500/60");
      } else {
        queueContainer?.classList.remove("animate-pulse", "border-green-500/60");
      }
    }
    if (bonusTemCountEl) bonusTemCountEl.textContent = bonusTemRemaining.toString();
    if (discountCountEl) discountCountEl.textContent = discountRemaining.toString();

    const bonusTemBtn = document.getElementById("powerup-bonus-tem") as HTMLButtonElement;
    const discountBtn = document.getElementById("powerup-discount") as HTMLButtonElement;

    if (bonusTemBtn) bonusTemBtn.disabled = bonusTemRemaining === 0;
    if (discountBtn) discountBtn.disabled = discountRemaining === 0 || isDiscountActive;
  }

  // Popup functions
  function showSuccessPopup(
    items: Array<{ name: string; price: string }>,
    total: string
  ) {
    const popup = document.getElementById("success-popup");
    const message = document.getElementById("popup-message");
    const details = document.getElementById("popup-details");

    if (message) {
      message.innerHTML = `
        <p class="text-lg mb-2">🎉 Bạn đã mua thành công ${items.length} mặt hàng!</p>
        <p class="text-sm text-green-200">📄 Tem phiếu đã được trừ tự động</p>
      `;
    }

    if (details) {
      details.innerHTML = `
        <div class="space-y-3">
          <div class="flex justify-between items-center border-b border-green-500/20 pb-3">
            <span class="text-green-100 font-semibold">Danh sách mua:</span>
          </div>
          ${items
            .map(
              (item) => `
            <div class="flex justify-between items-center text-sm">
              <span class="text-green-100">${item.name}</span>
              <span class="text-green-300 font-semibold">${item.price}</span>
            </div>
          `
            )
            .join("")}
          <div class="flex justify-between items-center pt-3 border-t border-green-500/20">
            <span class="text-white font-bold text-lg">Tổng cộng:</span>
            <span class="text-green-300 font-bold text-2xl">${total}</span>
          </div>
        </div>
      `;
    }

    popup?.classList.remove("hidden");
    popup?.classList.add("flex");

    // Play success sound (placeholder)
    playSound("success");
  }

  function playSound(type: string) {
    console.log(`🔊 Playing sound: ${type}`);
    // Placeholder for sound effects
  }

  document.getElementById("close-popup")?.addEventListener("click", () => {
    const popup = document.getElementById("success-popup");
    popup?.classList.add("hidden");
    popup?.classList.remove("flex");
  });

  function updateCart() {
    const cartItems = document.getElementById("cart-items");
    const totalPrice = document.getElementById("total-price");
    const itemCount = document.getElementById("item-count");
    const checkoutBtn = document.getElementById(
      "checkout-btn"
    ) as HTMLButtonElement;

    if (cart.length === 0) {
      cartItems!.innerHTML = `
        <div class="text-center text-neutral-500 py-12">
          <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <p>Giỏ hàng trống</p>
        </div>
      `;
      checkoutBtn!.disabled = true;
    } else {
      cartItems!.innerHTML = cart
        .map(
          (item, idx) => {
            const hasTem = temPhieu[item.tem] > 0;
            return `
        <div class="flex items-center justify-between p-3 bg-stone-900/50 border ${hasTem ? "border-amber-500/10" : "border-red-500/30"} rounded-lg transition-all">
          <div class="flex-1">
            <span class="text-neutral-200 block">${item.name}</span>
            ${!hasTem ? '<span class="text-xs text-red-400">⚠️ Thiếu tem phiếu</span>' : ''}
          </div>
          <div class="flex items-center gap-3">
            <span class="text-amber-400 font-semibold text-sm">${item.price}</span>
            <button class="remove-item w-6 h-6 bg-red-500/20 border border-red-500/40 rounded-full flex items-center justify-center hover:bg-red-500/40 transition-colors" data-index="${idx}">
              <svg class="w-3 h-3 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        </div>
      `;
          }
        )
        .join("");

      // Calculate total
      let total = cart.reduce((sum, item) => {
        const price = parseFloat(
          item.price
            .replace("đ/kg", "")
            .replace("đ/lít", "")
            .replace("đ/m", "")
            .replace("đ/bánh", "")
            .replace("đ/gói", "")
            .replace("đ/ổ", "")
        );
        return sum + price;
      }, 0);

      if (isDiscountActive) {
        total = total * 0.8;
        totalPrice!.innerHTML = `<span class="line-through text-neutral-500 text-sm mr-2">${cart.reduce((sum, item) => {
          const price = parseFloat(
            item.price
              .replace("đ/kg", "")
              .replace("đ/lít", "")
              .replace("đ/m", "")
              .replace("đ/bánh", "")
              .replace("đ/gói", "")
              .replace("đ/ổ", "")
          );
          return sum + price;
        }, 0).toFixed(2)}đ</span><span class="text-green-400">${total.toFixed(2)}đ</span> <span class="text-xs text-yellow-400">(-20%)</span>`;
      } else {
        totalPrice!.textContent = total.toFixed(2) + "đ";
      }

      itemCount!.textContent = cart.length.toString();
      
      // Check if all items have tem
      const allHaveTem = cart.every(item => temPhieu[item.tem] > 0);
      checkoutBtn!.disabled = !allHaveTem || cart.length === 0;
      
      if (!allHaveTem && cart.length > 0) {
        checkoutBtn!.title = "Một số mặt hàng thiếu tem phiếu!";
        checkoutBtn!.classList.add("opacity-50", "cursor-not-allowed");
      } else {
        checkoutBtn!.title = "";
        checkoutBtn!.classList.remove("opacity-50", "cursor-not-allowed");
      }

      // Add remove listeners
      document.querySelectorAll(".remove-item").forEach((btn) => {
        btn.addEventListener("click", () => {
          const btnEl = btn as HTMLButtonElement;
          const index = parseInt(btnEl.dataset.index || "0");
          cart.splice(index, 1);
          updateCart();
        });
      });
    }
  }

  // Add to cart
  document.querySelectorAll(".add-to-cart").forEach((btn) => {
    btn.addEventListener("click", () => {
      const btnElement = btn as HTMLButtonElement;
      const itemName = btnElement.dataset.item;
      const parentGrid = btnElement.closest(".grid");
      const itemData = parentGrid
        ?.querySelector(`[data-item="${itemName}"]`)
        ?.closest("div");

      if (itemData) {
        const price =
          itemData.querySelector(".text-amber-400")?.textContent || "0đ";
        const tem = itemTemMap[itemName || ""] || "";
        
        cart.push({ name: itemName || "", price, tem });
        updateCart();
        updateTemStatus();

        // Visual feedback
        btn.textContent = "✓ Đã thêm";
        btn.classList.add("bg-green-500", "from-green-500", "to-emerald-600");
        
        // Check tem availability
        if (temPhieu[tem] > 0) {
          showNotification(`✅ Đã thêm ${itemName} vào giỏ!`, "success", 2000);
        } else {
          showNotification(`⚠️ ${itemName} cần tem phiếu! Sử dụng Bonus Tem?`, "warning", 3000);
        }

        setTimeout(() => {
          btn.textContent = "Thêm vào giỏ";
          btn.classList.remove(
            "bg-green-500",
            "from-green-500",
            "to-emerald-600"
          );
        }, 1000);
      }
    });
  });

  // Checkout
  document.getElementById("checkout-btn")?.addEventListener("click", () => {
    if (cart.length === 0) return;

    // Validate all items have tem
    const missingTem = cart.filter(item => temPhieu[item.tem] === 0);
    if (missingTem.length > 0) {
      showNotification("❌ Một số mặt hàng thiếu tem phiếu! Không thể thanh toán.", "error", 3000);
      return;
    }

    // Calculate total
    let total = cart.reduce((sum, item) => {
      const price = parseFloat(
        item.price
          .replace("đ/kg", "")
          .replace("đ/lít", "")
          .replace("đ/m", "")
          .replace("đ/bánh", "")
          .replace("đ/gói", "")
          .replace("đ/ổ", "")
      );
      return sum + price;
    }, 0);

    const originalTotal = total;
    if (isDiscountActive) {
      total = total * 0.8;
      isDiscountActive = false;
      showNotification("✅ Đã áp dụng giảm giá 20%!", "success", 2000);
    }

    const cartCopy = cart.map(item => ({ name: item.name, price: item.price }));
    const totalStr = total.toFixed(2) + "đ";

    // Deduct tem phiếu
    cart.forEach(item => {
      if (temPhieu[item.tem] > 0) {
        temPhieu[item.tem]--;
      }
    });

    // Update stats
    totalPurchases++;
    totalSpent += total;
    
    // Achievements
    if (totalPurchases === 1) {
      checkAndAddAchievement("first_purchase", "🛒", "Mua hàng đầu tiên");
    }
    if (totalSpent >= 50) {
      checkAndAddAchievement("big_spender", "💰", "Tiêu nhiều tiền");
    }
    if (cart.length >= 5) {
      checkAndAddAchievement("bulk_buyer", "📦", "Mua số lượng lớn");
    }
    if (queueCount === 0) {
      checkAndAddAchievement("queue_master", "⚡", "Vượt qua hàng chờ");
    }

    // Show popup
    showSuccessPopup(cartCopy, totalStr);

    // Clear cart
    cart = [];
    updateCart();
    updateTemStatus();
    updateStats();

    // Decrease queue
    queueCount = Math.max(0, queueCount - 1);

    // Emotional feedback
    if (cartCopy.length >= 5) {
      showNotification(`🎉 Tuyệt vời! Bạn đã mua ${cartCopy.length} mặt hàng!`, "success", 3000);
    } else {
      showNotification(`✅ Mua hàng thành công!`, "success", 2000);
    }
  });

  // Power-ups
  function useBonusTem() {
    if (bonusTemRemaining === 0) return;
    
    bonusTemRemaining--;
    const temKeys = Object.keys(temPhieu);
    const randomTem = temKeys[Math.floor(Math.random() * temKeys.length)];
    temPhieu[randomTem]++;
    
    updateTemStatus();
    updateStats();
    showNotification(`🎁 Nhận bonus ${randomTem}!`, "success", 3000);
    checkAndAddAchievement("tem_collector", "📄", "Thu thập tem");
    playSound("bonus");
  }

  function useDiscount() {
    if (discountRemaining === 0 || isDiscountActive) return;
    
    discountRemaining--;
    isDiscountActive = true;
    updateStats();
    updateCart();
    
    const discountBtn = document.getElementById("powerup-discount") as HTMLButtonElement;
    if (discountBtn) {
      discountBtn.classList.add("powerup-active");
    }
    
    showNotification("💰 Giảm giá 20% cho lần mua tiếp theo!", "warning", 3000);
    checkAndAddAchievement("discount_user", "🎯", "Dùng giảm giá");
    playSound("discount");
  }

  // Power-up event listeners
  document.getElementById("powerup-bonus-tem")?.addEventListener("click", useBonusTem);
  document.getElementById("powerup-discount")?.addEventListener("click", useDiscount);

  // Initialize
  updateCart();
  updateTemStatus();
  updateStats();
  updateAchievements();

  // Auto-update queue occasionally
  setInterval(() => {
    if (queueCount > 0 && Math.random() > 0.7) {
      queueCount = Math.max(0, queueCount - Math.floor(Math.random() * 3));
      updateStats();
    }
  }, 3000);
</script>
