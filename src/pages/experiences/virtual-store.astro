---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icons.astro";
import SuccessPopup from "../../components/SuccessPopup.astro";

const storeItems = [
  {
    name: "Gạo",
    price: "0.15đ/kg",
    stock: "Còn 45kg",
    tem: "Tem Phiếu Gạo",
    icon: "🍚",
    available: true,
  },
  {
    name: "Thịt lợn",
    price: "2.5đ/kg",
    stock: "Hết hàng",
    tem: "Tem Phiếu Thịt",
    icon: "🥩",
    available: false,
  },
  {
    name: "Đường",
    price: "1.2đ/kg",
    stock: "Còn 12kg",
    tem: "Tem Phiếu Đường",
    icon: "🍬",
    available: true,
  },
  {
    name: "Dầu ăn",
    price: "3.0đ/lít",
    stock: "Còn 8 lít",
    tem: "Tem Phiếu Dầu",
    icon: "🫗",
    available: true,
  },
  {
    name: "Vải",
    price: "5.0đ/m",
    stock: "Hết hàng",
    tem: "Tem Phiếu Vải",
    icon: "👕",
    available: false,
  },
  {
    name: "Xà phòng",
    price: "0.8đ/bánh",
    stock: "Còn 20 bánh",
    tem: "Tem Phiếu XP",
    icon: "🧼",
    available: true,
  },
  {
    name: "Mì",
    price: "0.3đ/gói",
    stock: "Còn 100 gói",
    tem: "Tem Phiếu Mì",
    icon: "🍜",
    available: true,
  },
  {
    name: "Bánh mì",
    price: "0.1đ/ổ",
    stock: "Hết hàng",
    tem: "Tem Phiếu Bánh",
    icon: "🥖",
    available: false,
  },
];
---

<Layout title="Cửa hàng Mậu dịch Ảo | Trải nghiệm Bao Cấp">
  <main
    class="min-h-screen bg-gradient-to-b from-stone-950 via-neutral-900 to-stone-900 py-16 px-6"
  >
    <div class="max-w-7xl mx-auto">
      <!-- Back -->
      <a
        href="/#experience"
        class="inline-flex items-center gap-2 text-amber-400 hover:text-amber-300 font-semibold mb-12 transition-colors group"
      >
        <Icon
          name="arrow-left"
          class="w-5 h-5 group-hover:-translate-x-1 transition-transform"
        />
        Trở về Trải nghiệm
      </a>

      <!-- Store Header -->
      <div class="text-center mb-12">
        <div
          class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-amber-500 to-yellow-600 rounded-3xl mb-6 shadow-2xl"
        >
          <Icon name="shopping-cart" class="w-10 h-10 text-stone-950" />
        </div>
        <h1
          class="font-['Playfair_Display'] text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-amber-300 to-yellow-500 bg-clip-text text-transparent"
        >
          Cửa hàng Mậu dịch Nhà nước
        </h1>
        <p class="text-xl text-neutral-300 max-w-3xl mx-auto mb-6">
          Trải nghiệm mua sắm thời bao cấp - Cần tem phiếu mới mua được hàng!
        </p>

        <!-- Queue Status -->
        <div
          class="inline-flex items-center gap-3 px-6 py-3 bg-red-500/20 border border-red-500/40 rounded-full text-red-300 font-semibold"
        >
          <Icon name="users" class="w-5 h-5" />
          <span
            >Số người đang chờ: <span id="queue-count" class="font-bold"
              >47</span
            ></span
          >
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Left: Store Items -->
        <div class="lg:col-span-2">
          <div
            class="bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/30 rounded-3xl p-8 shadow-2xl"
          >
            <div class="flex items-center justify-between mb-8">
              <h2
                class="font-['Playfair_Display'] text-2xl font-bold text-amber-300 flex items-center gap-3"
              >
                <Icon name="collection" class="w-6 h-6" />
                Hàng hóa trong kho
              </h2>
              <div class="flex items-center gap-2 text-sm text-neutral-400">
                <Icon name="clock" class="w-4 h-4" />
                <span>Cập nhật: Hôm nay</span>
              </div>
            </div>

            <!-- Items Grid -->
            <div class="grid sm:grid-cols-2 gap-4">
              {
                storeItems.map((item) => (
                  <div
                    class={`relative p-6 rounded-2xl border-2 transition-all ${item.available ? "bg-stone-900/50 border-amber-500/20 hover:border-amber-500/50 hover:bg-stone-800/50" : "bg-stone-900/30 border-neutral-800 opacity-60"}`}
                  >
                    {!item.available && (
                      <div class="absolute top-3 right-3 px-3 py-1 bg-red-500/80 rounded-full text-white text-xs font-bold">
                        HẾT
                      </div>
                    )}
                    <div class="text-5xl mb-3">{item.icon}</div>
                    <h3 class="font-bold text-white mb-2 text-lg">
                      {item.name}
                    </h3>
                    <div class="space-y-1 text-sm mb-4">
                      <div class="flex items-center justify-between text-neutral-300">
                        <span>Giá:</span>
                        <span class="text-amber-400 font-bold">
                          {item.price}
                        </span>
                      </div>
                      <div class="flex items-center justify-between">
                        <span
                          class={
                            item.available ? "text-green-400" : "text-red-400"
                          }
                        >
                          {item.stock}
                        </span>
                      </div>
                    </div>
                    <div class="px-3 py-1.5 bg-amber-500/10 border border-amber-500/30 rounded-lg text-xs text-amber-300 text-center">
                      📄 Cần: {item.tem}
                    </div>
                    {item.available && (
                      <button
                        class="mt-4 w-full px-4 py-2 bg-gradient-to-r from-amber-500 to-yellow-600 rounded-lg text-stone-950 font-semibold hover:scale-105 transition-transform add-to-cart"
                        data-item={item.name}
                      >
                        Thêm vào giỏ
                      </button>
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Right: Shopping Cart -->
        <div class="lg:col-span-1">
          <div
            class="sticky top-24 bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/30 rounded-3xl p-8 shadow-2xl"
          >
            <div class="flex items-center gap-3 mb-6">
              <Icon name="shopping-cart" class="w-6 h-6 text-amber-400" />
              <h3
                class="font-['Playfair_Display'] text-2xl font-bold text-amber-300"
              >
                Giỏ hàng
              </h3>
            </div>

            <div id="cart-items" class="space-y-3 mb-6 min-h-[200px]">
              <div class="text-center text-neutral-500 py-12">
                <Icon
                  name="shopping-cart"
                  class="w-12 h-12 mx-auto mb-3 opacity-30"
                />
                <p>Giỏ hàng trống</p>
              </div>
            </div>

            <div class="border-t border-amber-500/20 pt-4 mb-6">
              <div class="flex justify-between text-lg mb-2">
                <span class="text-neutral-300">Tổng tiền:</span>
                <span class="text-amber-400 font-bold" id="total-price"
                  >0.00đ</span
                >
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-neutral-400">Số món:</span>
                <span class="text-neutral-300" id="item-count">0</span>
              </div>
            </div>

            <button
              id="checkout-btn"
              class="w-full px-6 py-4 bg-gradient-to-r from-green-500 to-emerald-600 rounded-xl text-white font-bold shadow-xl hover:scale-105 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
              disabled
            >
              <Icon name="check" class="w-5 h-5" />
              Thanh toán
            </button>

            <!-- Tem Phieu Status -->
            <div
              class="mt-6 p-4 bg-amber-900/20 border border-amber-500/20 rounded-xl"
            >
              <div class="flex items-center gap-2 mb-2">
                <Icon name="document" class="w-4 h-4 text-amber-400" />
                <span class="text-sm font-semibold text-amber-300"
                  >Tem phiếu còn lại:</span
                >
              </div>
              <div class="text-xs text-neutral-400 space-y-1" id="tem-status">
                <div>• Tem Gạo: ✓</div>
                <div>• Tem Đường: ✓</div>
                <div>• Tem Dầu: ✓</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Historical Context -->
      <div
        class="mt-16 bg-gradient-to-br from-amber-900/20 to-yellow-900/10 backdrop-blur-xl border border-amber-500/20 rounded-3xl p-10"
      >
        <div class="flex items-center gap-3 mb-6">
          <Icon name="information" class="w-8 h-8 text-amber-400" />
          <h3
            class="font-['Playfair_Display'] text-2xl font-bold text-amber-300"
          >
            Về cửa hàng mậu dịch
          </h3>
        </div>
        <div class="grid md:grid-cols-3 gap-6 text-neutral-200">
          <div
            class="bg-stone-900/30 border border-amber-500/10 rounded-xl p-6"
          >
            <h4 class="font-bold text-amber-300 mb-3">Giờ mở cửa</h4>
            <p class="text-sm leading-relaxed">
              Thường 6h-11h sáng và 14h-17h chiều. Đến muộn có thể hết hàng.
            </p>
          </div>
          <div
            class="bg-stone-900/30 border border-amber-500/10 rounded-xl p-6"
          >
            <h4 class="font-bold text-amber-300 mb-3">Hàng hóa</h4>
            <p class="text-sm leading-relaxed">
              Chủ yếu là thực phẩm thiết yếu. Hàng công nghiệp rất khan hiếm.
            </p>
          </div>
          <div
            class="bg-stone-900/30 border border-amber-500/10 rounded-xl p-6"
          >
            <h4 class="font-bold text-amber-300 mb-3">Quy định</h4>
            <p class="text-sm leading-relaxed">
              Bắt buộc phải có tem phiếu. Không được mua vượt định mức.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SuccessPopup />
</Layout>

<script>
  let cart: Array<{ name: string; price: string }> = [];

  // Popup functions
  function showSuccessPopup(
    items: Array<{ name: string; price: string }>,
    total: string
  ) {
    const popup = document.getElementById("success-popup");
    const message = document.getElementById("popup-message");
    const details = document.getElementById("popup-details");

    if (message) {
      message.innerHTML = `
        <p class="text-lg mb-2">🎉 Bạn đã mua thành công ${items.length} mặt hàng!</p>
        <p class="text-sm text-green-200">📄 Tem phiếu đã được trừ tự động</p>
      `;
    }

    if (details) {
      details.innerHTML = `
        <div class="space-y-3">
          <div class="flex justify-between items-center border-b border-green-500/20 pb-3">
            <span class="text-green-100 font-semibold">Danh sách mua:</span>
          </div>
          ${items
            .map(
              (item) => `
            <div class="flex justify-between items-center text-sm">
              <span class="text-green-100">${item.name}</span>
              <span class="text-green-300 font-semibold">${item.price}</span>
            </div>
          `
            )
            .join("")}
          <div class="flex justify-between items-center pt-3 border-t border-green-500/20">
            <span class="text-white font-bold text-lg">Tổng cộng:</span>
            <span class="text-green-300 font-bold text-2xl">${total}</span>
          </div>
        </div>
      `;
    }

    popup?.classList.remove("hidden");
    popup?.classList.add("flex");

    // Play success sound (placeholder)
    playSound("success");
  }

  function playSound(type: string) {
    console.log(`🔊 Playing sound: ${type}`);
    // Placeholder for sound effects
  }

  document.getElementById("close-popup")?.addEventListener("click", () => {
    const popup = document.getElementById("success-popup");
    popup?.classList.add("hidden");
    popup?.classList.remove("flex");
  });

  function updateCart() {
    const cartItems = document.getElementById("cart-items");
    const totalPrice = document.getElementById("total-price");
    const itemCount = document.getElementById("item-count");
    const checkoutBtn = document.getElementById(
      "checkout-btn"
    ) as HTMLButtonElement;

    if (cart.length === 0) {
      cartItems!.innerHTML = `
        <div class="text-center text-neutral-500 py-12">
          <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <p>Giỏ hàng trống</p>
        </div>
      `;
      checkoutBtn!.disabled = true;
    } else {
      cartItems!.innerHTML = cart
        .map(
          (item, idx) => `
        <div class="flex items-center justify-between p-3 bg-stone-900/50 border border-amber-500/10 rounded-lg">
          <span class="text-neutral-200">${item.name}</span>
          <div class="flex items-center gap-3">
            <span class="text-amber-400 font-semibold text-sm">${item.price}</span>
            <button class="remove-item w-6 h-6 bg-red-500/20 border border-red-500/40 rounded-full flex items-center justify-center hover:bg-red-500/40 transition-colors" data-index="${idx}">
              <svg class="w-3 h-3 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        </div>
      `
        )
        .join("");

      // Calculate total
      const total = cart.reduce((sum, item) => {
        const price = parseFloat(
          item.price
            .replace("đ/kg", "")
            .replace("đ/lít", "")
            .replace("đ/m", "")
            .replace("đ/bánh", "")
            .replace("đ/gói", "")
            .replace("đ/ổ", "")
        );
        return sum + price;
      }, 0);

      totalPrice!.textContent = total.toFixed(2) + "đ";
      itemCount!.textContent = cart.length.toString();
      checkoutBtn!.disabled = false;

      // Add remove listeners
      document.querySelectorAll(".remove-item").forEach((btn) => {
        btn.addEventListener("click", () => {
          const btnEl = btn as HTMLButtonElement;
          const index = parseInt(btnEl.dataset.index || "0");
          cart.splice(index, 1);
          updateCart();
        });
      });
    }
  }

  // Add to cart
  document.querySelectorAll(".add-to-cart").forEach((btn) => {
    btn.addEventListener("click", () => {
      const btnElement = btn as HTMLButtonElement;
      const itemName = btnElement.dataset.item;
      const parentGrid = btnElement.closest(".grid");
      const itemData = parentGrid
        ?.querySelector(`[data-item="${itemName}"]`)
        ?.closest("div");

      if (itemData) {
        const price =
          itemData.querySelector(".text-amber-400")?.textContent || "0đ";
        cart.push({ name: itemName || "", price });
        updateCart();

        // Visual feedback
        btn.textContent = "✓ Đã thêm";
        btn.classList.add("bg-green-500", "from-green-500", "to-emerald-600");
        setTimeout(() => {
          btn.textContent = "Thêm vào giỏ";
          btn.classList.remove(
            "bg-green-500",
            "from-green-500",
            "to-emerald-600"
          );
        }, 1000);
      }
    });
  });

  // Checkout
  document.getElementById("checkout-btn")?.addEventListener("click", () => {
    if (cart.length > 0) {
      const total = document.getElementById("total-price")?.textContent || "0đ";
      const cartCopy = [...cart];

      // Show beautiful popup
      showSuccessPopup(cartCopy, total);

      // Clear cart
      cart = [];
      updateCart();

      // Decrease queue
      const queueEl = document.getElementById("queue-count");
      if (queueEl) {
        const current = parseInt(queueEl.textContent || "47");
        queueEl.textContent = Math.max(0, current - 1).toString();
      }
    }
  });

  updateCart();
</script>
