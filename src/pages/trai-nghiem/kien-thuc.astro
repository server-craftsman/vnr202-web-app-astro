---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icons.astro";
import { quizQuestions } from "../../data/quiz";
---

<Layout title="Kiến thức & Câu đố | Bao Cấp Quiz">
  <main
    class="min-h-screen bg-gradient-to-b from-stone-950 via-neutral-900 to-stone-900 py-16 px-6"
  >
    <div class="max-w-5xl mx-auto">
      <!-- Back -->
      <a
        href="/#trai-nghiem"
        class="inline-flex items-center gap-2 text-amber-400 hover:text-amber-300 font-semibold mb-12 transition-colors group"
      >
        <Icon
          name="arrow-left"
          class="w-5 h-5 group-hover:-translate-x-1 transition-transform"
        />
        Trở về Trải nghiệm
      </a>

      <!-- Header -->
      <div class="text-center mb-12">
        <div
          class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-3xl mb-6 shadow-2xl animate-pulse"
        >
          <Icon name="academic-cap" class="w-10 h-10 text-white" />
        </div>
        <h1
          class="font-['Playfair_Display'] text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-indigo-300 via-purple-300 to-pink-400 bg-clip-text text-transparent"
        >
          Kiến thức & Câu đố
        </h1>
        <p class="text-xl text-neutral-300 max-w-3xl mx-auto">
          Kiểm tra hiểu biết của bạn về thời kỳ bao cấp Việt Nam
        </p>
      </div>

      <!-- Quiz Stats -->
      <div class="grid grid-cols-3 gap-4 mb-8" id="quiz-stats">
        <div
          class="bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-indigo-500/30 rounded-2xl p-6 text-center"
        >
          <Icon
            name="light-bulb"
            class="w-8 h-8 text-indigo-400 mx-auto mb-2"
          />
          <div class="text-3xl font-bold text-indigo-300 mb-1">
            <span id="current-q">1</span>/<span id="total-q">10</span>
          </div>
          <div class="text-neutral-400 text-sm">Câu hỏi</div>
        </div>
        <div
          class="bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-green-500/30 rounded-2xl p-6 text-center"
        >
          <Icon name="check" class="w-8 h-8 text-green-400 mx-auto mb-2" />
          <div class="text-3xl font-bold text-green-300 mb-1" id="correct">
            0
          </div>
          <div class="text-neutral-400 text-sm">Đúng</div>
        </div>
        <div
          class="bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/30 rounded-2xl p-6 text-center"
        >
          <Icon name="star" class="w-8 h-8 text-amber-400 mx-auto mb-2" />
          <div class="text-3xl font-bold text-amber-300 mb-1">
            <span id="score">0</span>đ
          </div>
          <div class="text-neutral-400 text-sm">Điểm</div>
        </div>
      </div>

      <!-- Quiz Container -->
      <div
        id="quiz-container"
        class="bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-indigo-500/30 rounded-3xl p-12 shadow-2xl"
      >
        <!-- Question will be rendered by JS -->
      </div>

      <!-- Result Screen -->
      <div
        id="result-screen"
        class="hidden bg-gradient-to-br from-stone-800/40 to-stone-900/40 backdrop-blur-xl border border-amber-500/30 rounded-3xl p-12 shadow-2xl text-center"
      >
        <div id="result-icon" class="text-8xl mb-6"></div>
        <h2
          class="font-['Playfair_Display'] text-4xl font-bold mb-4 text-amber-300"
          id="result-title"
        >
        </h2>
        <div
          class="text-6xl font-bold bg-gradient-to-r from-amber-300 to-yellow-500 bg-clip-text text-transparent mb-6"
        >
          <span id="final-score">0</span>/<span id="max-score">100</span> điểm
        </div>
        <div class="text-xl text-neutral-300 mb-4">
          Số câu đúng: <span id="final-correct" class="text-green-400 font-bold"
            >0</span
          >/<span id="final-total">10</span>
        </div>
        <div id="rating-text" class="text-lg text-neutral-400 mb-8"></div>
        <button
          id="restart-quiz"
          class="inline-flex items-center gap-3 px-10 py-4 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full text-white font-bold text-lg shadow-2xl hover:scale-105 transition-all duration-300"
        >
          <Icon name="arrow-left" class="w-6 h-6" />
          Làm lại
        </button>
      </div>

      <!-- Knowledge Section -->
      <div
        class="mt-16 bg-gradient-to-br from-amber-900/20 to-yellow-900/10 backdrop-blur-xl border border-amber-500/20 rounded-3xl p-10"
      >
        <div class="flex items-center gap-3 mb-6">
          <Icon name="book" class="w-8 h-8 text-amber-400" />
          <h3
            class="font-['Playfair_Display'] text-2xl font-bold text-amber-300"
          >
            Kiến thức nền tảng
          </h3>
        </div>
        <div class="grid md:grid-cols-2 gap-6 text-neutral-200">
          <div
            class="bg-stone-900/30 border border-amber-500/10 rounded-xl p-6"
          >
            <h4 class="font-bold text-amber-300 mb-3 flex items-center gap-2">
              <Icon name="information" class="w-5 h-5" />
              Bao cấp là gì?
            </h4>
            <p class="leading-relaxed text-sm">
              Bao cấp là cơ chế kinh tế mà nhà nước quy định giá cả, sản xuất,
              phân phối tất cả hàng hóa. Người dân không được tự do mua bán.
            </p>
          </div>
          <div
            class="bg-stone-900/30 border border-amber-500/10 rounded-xl p-6"
          >
            <h4 class="font-bold text-amber-300 mb-3 flex items-center gap-2">
              <Icon name="clock" class="w-5 h-5" />
              Tại sao kéo dài 11 năm?
            </h4>
            <p class="leading-relaxed text-sm">
              Do hệ tư tưởng, phụ thuộc viện trợ Liên Xô, thiếu vốn & công nghệ,
              và cần thời gian để nhận ra hạn chế của mô hình.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ quizQuestions }}>
  (function () {
    if (!quizQuestions || quizQuestions.length === 0) {
      console.error("Quiz questions not loaded");
      return;
    }

    let currentQuestion = 0;
    let correctAnswers = 0;
    let score = 0;
    let answered = false;

    const quizContainer = document.getElementById("quiz-container");
    const resultScreen = document.getElementById("result-screen");

    if (!quizContainer || !resultScreen) {
      console.error("Quiz container or result screen not found");
      return;
    }

    function getDifficultyClass(difficulty) {
      switch (difficulty) {
        case "easy":
          return {
            bg: "bg-green-500/20",
            border: "border-green-500/40",
            text: "text-green-300",
            label: "⭐ Dễ",
          };
        case "medium":
          return {
            bg: "bg-yellow-500/20",
            border: "border-yellow-500/40",
            text: "text-yellow-300",
            label: "⭐⭐ Trung bình",
          };
        case "hard":
          return {
            bg: "bg-red-500/20",
            border: "border-red-500/40",
            text: "text-red-300",
            label: "⭐⭐⭐ Khó",
          };
        default:
          return {
            bg: "bg-indigo-500/20",
            border: "border-indigo-500/40",
            text: "text-indigo-300",
            label: "⭐",
          };
      }
    }

    function getCategoryLabel(category) {
      switch (category) {
        case "history":
          return "📚 Lịch sử";
        case "economy":
          return "💰 Kinh tế";
        case "culture":
          return "🎭 Văn hóa";
        case "society":
          return "👥 Xã hội";
        default:
          return "📖 Kiến thức";
      }
    }

    function renderQuestion() {
      if (currentQuestion >= quizQuestions.length) {
        showResult();
        return;
      }

      const q = quizQuestions[currentQuestion];
      if (!q) {
        console.error("Question not found at index:", currentQuestion);
        return;
      }

      answered = false;

      // Update stats
      const currentQEl = document.getElementById("current-q");
      const totalQEl = document.getElementById("total-q");
      if (currentQEl) currentQEl.textContent = (currentQuestion + 1).toString();
      if (totalQEl) totalQEl.textContent = quizQuestions.length.toString();

      const difficultyClass = getDifficultyClass(q.difficulty);
      const categoryLabel = getCategoryLabel(q.category);

      quizContainer.innerHTML = `
        <div class="mb-8">
          <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
            <span class="px-4 py-2 bg-indigo-500/20 border border-indigo-500/40 rounded-full text-indigo-300 text-sm font-semibold">
              ${categoryLabel}
            </span>
            <span class="px-4 py-2 ${difficultyClass.bg} border ${difficultyClass.border} rounded-full ${difficultyClass.text} text-sm font-semibold">
              ${difficultyClass.label}
            </span>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white mb-8 leading-relaxed">
            ${q.question}
          </h3>
        </div>

        <div class="space-y-4" id="options-container">
          ${q.options
            .map(
              (option, index) => `
            <button class="option-btn w-full text-left p-6 bg-stone-900/50 border-2 border-neutral-700 rounded-2xl hover:border-indigo-500/50 hover:bg-stone-800/50 transition-all group cursor-pointer" data-index="${index}">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-neutral-800 border-2 border-neutral-700 rounded-xl flex items-center justify-center text-neutral-400 font-bold group-hover:border-indigo-500 group-hover:text-indigo-300 transition-colors flex-shrink-0">
                  ${String.fromCharCode(65 + index)}
                </div>
                <span class="text-lg text-neutral-200 group-hover:text-white transition-colors flex-1">${option}</span>
              </div>
            </button>
          `
            )
            .join("")}
        </div>

        <div id="explanation" class="hidden mt-8 p-6 rounded-2xl">
          <!-- Will be filled after answer -->
        </div>

        <div class="mt-8 flex justify-end">
          <button id="next-btn" class="hidden px-8 py-3 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full text-white font-semibold shadow-xl hover:scale-105 transition-all flex items-center gap-2">
            <span>Câu tiếp theo</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      `;

      // Add event listeners
      document.querySelectorAll(".option-btn").forEach((btn) => {
        btn.addEventListener("click", function () {
          const index = parseInt(this.getAttribute("data-index") || "0");
          handleAnswer(index);
        });
      });

      const nextBtn = document.getElementById("next-btn");
      if (nextBtn) {
        nextBtn.addEventListener("click", nextQuestion);
      }
    }

    function handleAnswer(selectedIndex) {
      if (answered) return;

      const q = quizQuestions[currentQuestion];
      if (!q) {
        console.error("Question not found");
        return;
      }

      answered = true;

      const isCorrect = selectedIndex === q.correctAnswer;
      const options = document.querySelectorAll(".option-btn");
      const explanationEl = document.getElementById("explanation");
      const nextBtn = document.getElementById("next-btn");

      // Disable all options
      options.forEach((opt, idx) => {
        opt.classList.add("pointer-events-none", "cursor-not-allowed");

        if (idx === q.correctAnswer) {
          opt.classList.remove(
            "border-neutral-700",
            "hover:border-indigo-500/50",
            "hover:bg-stone-800/50"
          );
          opt.classList.add("border-green-500", "bg-green-500/20");
          const letterEl = opt.querySelector("div div");
          if (letterEl) {
            letterEl.classList.remove(
              "border-neutral-700",
              "text-neutral-400",
              "group-hover:border-indigo-500",
              "group-hover:text-indigo-300"
            );
            letterEl.classList.add(
              "border-green-500",
              "text-green-300",
              "bg-green-500/30"
            );
          }
        } else if (idx === selectedIndex && !isCorrect) {
          opt.classList.remove(
            "border-neutral-700",
            "hover:border-indigo-500/50",
            "hover:bg-stone-800/50"
          );
          opt.classList.add("border-red-500", "bg-red-500/20");
          const letterEl = opt.querySelector("div div");
          if (letterEl) {
            letterEl.classList.remove(
              "border-neutral-700",
              "text-neutral-400",
              "group-hover:border-indigo-500",
              "group-hover:text-indigo-300"
            );
            letterEl.classList.add(
              "border-red-500",
              "text-red-300",
              "bg-red-500/30"
            );
          }
        } else {
          opt.classList.add("opacity-50");
        }
      });

      // Update score
      if (isCorrect) {
        correctAnswers++;
        const points =
          q.difficulty === "easy" ? 5 : q.difficulty === "medium" ? 10 : 15;
        score += points;

        const correctEl = document.getElementById("correct");
        const scoreEl = document.getElementById("score");
        if (correctEl) correctEl.textContent = correctAnswers.toString();
        if (scoreEl) scoreEl.textContent = score.toString();
      }

      // Show explanation
      if (explanationEl) {
        explanationEl.classList.remove("hidden");
        explanationEl.className = `mt-8 p-6 rounded-2xl border-2 ${isCorrect ? "bg-green-500/10 border-green-500/30" : "bg-red-500/10 border-red-500/30"}`;
        explanationEl.innerHTML = `
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-8 h-8 ${isCorrect ? "bg-green-500/30" : "bg-red-500/30"} rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 ${isCorrect ? "text-green-400" : "text-red-400"}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                ${isCorrect ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>' : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>'}
              </svg>
            </div>
            <div class="flex-1">
              <div class="font-bold ${isCorrect ? "text-green-300" : "text-red-300"} mb-2 text-lg">
                ${isCorrect ? "✅ Chính xác!" : "❌ Chưa đúng"}
              </div>
              <p class="text-neutral-200 leading-relaxed">
                ${q.explanation}
              </p>
            </div>
          </div>
        `;
      }

      // Show next button
      if (nextBtn) {
        nextBtn.classList.remove("hidden");
      }
    }

    function nextQuestion() {
      currentQuestion++;
      renderQuestion();
    }

    function showResult() {
      quizContainer.classList.add("hidden");
      const statsEl = document.getElementById("quiz-stats");
      if (statsEl) statsEl.classList.add("hidden");
      resultScreen.classList.remove("hidden");

      const maxScore = quizQuestions.reduce(
        (sum, q) =>
          sum +
          (q.difficulty === "easy" ? 5 : q.difficulty === "medium" ? 10 : 15),
        0
      );
      const percentage = Math.round((score / maxScore) * 100);

      const finalScoreEl = document.getElementById("final-score");
      const maxScoreEl = document.getElementById("max-score");
      const finalCorrectEl = document.getElementById("final-correct");
      const finalTotalEl = document.getElementById("final-total");

      if (finalScoreEl) finalScoreEl.textContent = score.toString();
      if (maxScoreEl) maxScoreEl.textContent = maxScore.toString();
      if (finalCorrectEl)
        finalCorrectEl.textContent = correctAnswers.toString();
      if (finalTotalEl)
        finalTotalEl.textContent = quizQuestions.length.toString();

      let icon, title, rating;
      if (percentage >= 90) {
        icon = "🏆";
        title = "Xuất sắc!";
        rating = "Bạn là chuyên gia về lịch sử thời bao cấp!";
      } else if (percentage >= 70) {
        icon = "🎉";
        title = "Giỏi lắm!";
        rating = "Bạn có kiến thức tốt về giai đoạn này.";
      } else if (percentage >= 50) {
        icon = "👍";
        title = "Khá đấy!";
        rating = "Bạn đã nắm được những kiến thức cơ bản.";
      } else {
        icon = "📚";
        title = "Cố gắng thêm nhé!";
        rating = "Hãy tìm hiểu thêm về lịch sử để làm tốt hơn.";
      }

      const resultIconEl = document.getElementById("result-icon");
      const resultTitleEl = document.getElementById("result-title");
      const ratingTextEl = document.getElementById("rating-text");

      if (resultIconEl) resultIconEl.textContent = icon;
      if (resultTitleEl) resultTitleEl.textContent = title;
      if (ratingTextEl) ratingTextEl.textContent = rating;
    }

    function restartQuiz() {
      currentQuestion = 0;
      correctAnswers = 0;
      score = 0;
      answered = false;

      const correctEl = document.getElementById("correct");
      const scoreEl = document.getElementById("score");
      if (correctEl) correctEl.textContent = "0";
      if (scoreEl) scoreEl.textContent = "0";

      quizContainer.classList.remove("hidden");
      const statsEl = document.getElementById("quiz-stats");
      if (statsEl) statsEl.classList.remove("hidden");
      resultScreen.classList.add("hidden");

      renderQuestion();
    }

    const restartBtn = document.getElementById("restart-quiz");
    if (restartBtn) {
      restartBtn.addEventListener("click", restartQuiz);
    }

    // Initialize when DOM is ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderQuestion);
    } else {
      renderQuestion();
    }
  })();
</script>
